#!/usr/bin/env bash
# Installs npm-global CLI tools that have no homebrew formula or where the brew
# version lags upstream. Re-runs whenever this script's content changes (so
# editing the `tools` array below triggers reinstall on next `chezmoi apply`).
set -euo pipefail

# Pick up brew-installed node on both macOS (/opt/homebrew) and Linux (/home/linuxbrew/.linuxbrew).
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "npm not found; skipping npm-globals install" >&2
  exit 0
fi

# Skill-driven tools the agents depend on. See agent-skills/<name>/SKILL.md for
# why each one is here. Keep this list short — npm globals rot fast.
tools=(
  "tsx"   # TS runtime for mcp-debugger's js-debug adapter (agent-skills/mcp-debugger);
          # it probes node_modules/.bin then PATH — global tsx = .ts debugging works in any repo
  "scriptc"  # vercel-labs/scriptc — compiles TS to a native binary (LLVM IR / C backend),
             # no Node or V8 in the output. Needs node 24+ and clang at BUILD time only.
             # Experimental (0.0.x) — pin nothing yet, just track latest.
  "@wallabyjs/cli@latest"  # `wallaby-skill` for agent-skills/wallaby-cli. Back 2026-10-13: since
                           # 1.0.x the CLI starts Wallaby in the background, no editor needed.
  "basti"  # basti-app/basti — AWS bastion tunnels (`basti connect`), prod DB access;
           # completions in dot_config/nushell/autoload/basti.nu
)

for tool in "${tools[@]}"; do
  echo "npm install -g $tool"
  npm install -g --silent "$tool"
done
