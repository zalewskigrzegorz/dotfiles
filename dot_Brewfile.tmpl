{{- end -}}
{{- $setapp := false -}}
{{- with (index . "setapp") -}}
{{- $setapp = . -}}
{{- end -}}
tap "oven-sh/bun"
tap "modem-dev/tap"

brew "agent-browser"
brew "aria2"
brew "ast-grep"
brew "awscli"
brew "bat"
brew "btop"
brew "carapace"
brew "chezmoi"
brew "cmake"
brew "coreutils"
brew "deno"
brew "direnv"
brew "dust"
brew "entr"
brew "eza"
brew "fd"
brew "ffmpeg"
brew "fzf"
brew "gawk"
brew "gh"
brew "git"
brew "git-delta"
brew "actionlint"   # lints .github/workflows before push (hook actionlint-workflows.sh)
brew "gitleaks"
brew "gnupg"
brew "go"
brew "herdr"   # agent multiplexer, see docs/herdr.md
# nomad/terraform/vault: dropped from global brew 2026-06-10 — used only in
# the work monorepo via mise (mise.toml pins exact versions). Re-add here
# if you ever need them outside work repos.
brew "docker"
brew "docker-buildx"
brew "docker-compose"
brew "hyperfine"
brew "jq"
brew "just"
brew "lazydocker"
brew "lazygit"
brew "lnav"
brew "lua"
brew "mise"
# mupdf, ocrmypdf, poppler, qpdf, tesseract-lang: pdf-form-pl and Skaner reads
# (pdftoppm, OCR, merging scans).
brew "mupdf"
brew "neovim"
brew "node"
brew "nushell"
brew "ocrmypdf"
brew "oven-sh/bun/bun"
brew "poppler"
brew "qpdf"
# sox: `rec` nagrywa z mikrofonu Maca dla `tina listen` (push-to-talk do Tiny).
# Bez niego komenda odmawia startu i podpowiada instalację.
brew "sox"
# pay-respects: installed + pinned by run_onchange_after_10-brew-bundle.sh
# (tap ships a rolling "nightly" with a perma-stale sha256 that breaks bundle)
brew "rclone"
brew "ripgrep"
brew "rsync"
# rtk: CLI proxy that compresses command output before it reaches an agent's
# context. Wired in as a PreToolUse Bash hook — see agent-rules/rtk-output-compression.md.
brew "rtk"
brew "rust"
brew "spicetify-cli"
brew "starship"
brew "superfile"
brew "tesseract-lang"
brew "television"
brew "tree"
brew "trufflehog"
brew "uv"
brew "vivid"
brew "wget"
brew "yq"
brew "yt-dlp"
brew "zig"
brew "zoxide"

{{ if eq .chezmoi.os "linux" -}}
# Headless/Linux: 1Password CLI (`op`) is NOT in homebrew on Linux.
# Install manually before running secrets restore:
#   curl -sS https://downloads.1password.com/linux/keys/1password.asc \
#     | sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg
#   echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" \
#     | sudo tee /etc/apt/sources.list.d/1password.list
#   sudo apt update && sudo apt install -y 1password-cli
# Docs: https://developer.1password.com/docs/cli/get-started/
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
tap "felixkratz/formulae"
tap "mickamy/tap"
tap "nikitabobko/tap"
tap "nnnkkk7/tap"
tap "timrogers/tap"
tap "vimma-browser/tap"
