brew "felixkratz/formulae/sketchybar"
brew "flock"      # macOS lacks flock; on Linux it ships with system util-linux
brew "choose-gui" # native floating fuzzy picker — bin/dygma-cheats --choose
brew "colima"     # macOS Docker VM runtime; Linux runs Docker natively (no colima)
brew "fswatch"
brew "gnu-sed"
brew "nowplaying-cli"
brew "nss"
brew "pam-reattach"
brew "pngpaste"
brew "spotify_player"
brew "switchaudio-osx"
brew "timrogers/tap/litra"

{{ if eq $profile "workstation" -}}
brew "libpq"
brew "mysql-client"

cask "1password"
cask "1password-cli"
# bitwarden: NOT brew-managed. Iru/Kandji (MDM) installs it into /Applications as
# root:wheel, so `brew upgrade` can only chown-fail against it and brew's own copy
# rotted at 2022.9.1 since Mar 2024. Updates come from MDM. Same story for slack.
# claude-code: installed via native installer (`claude install latest`) — auto-updates,
# brew cask lags 2+ weeks behind. See run_once_after_25-install-claude.sh.tmpl.
cask "bazecor"
cask "clop"
cask "comet"
cask "elgato-stream-deck"
cask "firefox@developer-edition"
cask "font-atkinson-hyperlegible-mono"
cask "font-atkinson-hyperlegible-next"
cask "font-fira-code-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-sf-pro"         # sketchybar caffeine widget
cask "ghostty"
cask "glaze"
cask "google-chrome"
cask "google-drive"
cask "zacharytgray/hyprmac/hyprmac" # tiling WM; third-party tap: run `brew trust --cask zacharytgray/hyprmac/hyprmac` once first
cask "iina"
cask "insomnia"
cask "insta360-link-controller"
cask "kindavim"
cask "music-decoy"
cask "mutedeck"
cask "notion-calendar"
cask "obsidian"
cask "rapidapi"
cask "raycast"
cask "sf-symbols"
# slack: MDM-installed (root:admin), see the bitwarden note above.
cask "spotify"
cask "tailscale-app"
cask "vimma-browser/tap/vimma" # not notarised: first launch needs `xattr -dr com.apple.quarantine /Applications/Vimma.app`
cask "wooshy"
cask "zed"
{{ if $setapp -}}
cask "setapp"
{{ end -}}
{{ end -}}
{{ end -}}
