#!/usr/bin/env bash
# gen-pr-sounds — one-off: generate the pr-watch alert sounds with ElevenLabs
# Sound Effects (POST /v1/sound-generation) into assets/sounds/. Re-run only to
# replace a sound; `gen-pr-sounds ci_fail` regenerates just that one.
# Key: $ELEVENLABS_API_KEY, else the line in ~/.config/nushell/autoload/private.nu
# (same lookup as bin/read-claude). The key goes to curl on stdin, never in argv.
set -euo pipefail

# Every run is a new take: generate candidates elsewhere, listen, copy the keepers in by hand.
out="${PR_SOUNDS_OUT:-$(cd "$(dirname "$0")/.." && pwd)/assets/sounds}"
mkdir -p "$out"

key="${ELEVENLABS_API_KEY:-}"
if [ -z "$key" ]; then
  key=$(sed -nE 's/.*ELEVENLABS_API_KEY"?[[:space:]]*[:=][[:space:]]*"([^"]+)".*/\1/p' "$HOME/.config/nushell/autoload/private.nu" 2>/dev/null | head -n1)
fi
[ -n "$key" ] || { echo "gen-pr-sounds: no ELEVENLABS_API_KEY" >&2; exit 1; }

declare -A prompt=(
# Cyberpunk HUD palette, soft on purpose: warm analog synth, no bells, glass or metal.
  [ci_fail]="two flat low synth tones, second lower, cyberpunk access denied, muted, firm, no buzzer, no bells, no glass"
  [approval]="soft cyberpunk HUD confirmation, warm rising analog synth pad swell, mellow, gentle, no bells, no glass"
  [ci_success]="confident cyberpunk mission complete: one warm bright major synth chord that blooms and resolves, decisive, no beeps, no bells, no glass"
  [comment]="two soft dry muted synth ticks, minimal clean UI tap, close and quiet, no bells, no glass"
  [ci_start]="soft rising synth whoosh, cyberpunk process starting, quiet, short, no bells, no glass"
)
# seconds per sound, default 1; a build-up needs room
declare -A dur=([ci_success]=1.5)

for kind in "${@:-ci_fail approval ci_success comment ci_start}"; do
  for k in $kind; do
    d="${dur[$k]:-1}"
    # PR_SOUND_PROMPT: try a one-off direction without editing the table
    body=$(printf '{"text":"%s","duration_seconds":%s,"prompt_influence":%s}' "${PR_SOUND_PROMPT:-${prompt[$k]}}" "$d" "${PR_SOUND_INFLUENCE:-0.7}")
    printf 'xi-api-key: %s\n' "$key" | curl -sS --fail-with-body -X POST \
      'https://api.elevenlabs.io/v1/sound-generation?output_format=mp3_44100_128' \
      -H @- -H 'Content-Type: application/json' -d "$body" -o "$out/pr-$k.raw.mp3"
    # the model's output level varies a lot (one came back 18 dB quieter); even them out.
    # -24 LUFS sits well under music (-14 hit like a slap); the fade kills a clipped tail.
    ffmpeg -hide_banner -loglevel error -y -i "$out/pr-$k.raw.mp3" -af "loudnorm=I=-24:TP=-3,afade=t=out:st=$(awk "BEGIN{print $d - 0.25}"):d=0.25" -ar 44100 -b:a 128k "$out/pr-$k.mp3"
    rm "$out/pr-$k.raw.mp3"
    echo "pr-$k.mp3 $(wc -c < "$out/pr-$k.mp3") bytes"
  done
done
