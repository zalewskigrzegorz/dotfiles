agent-rules/**
agent-mcp/**

# sketchybar-watcher is built and run straight out of the source dir
# (~/Code/dotfiles/bin/sketchybar-watcher/) by run_onchange_after_36 — sketchybar
# init.lua and aerospace's after-startup-command both exec that path. Copying the
# 4 MB binary + its .go sources to ~/bin/ serves nobody, and since the rebuild
# stamps -X main.buildTime the copy is stale the moment it lands, so `chezmoi
# diff` could never be clean.
bin/sketchybar-watcher/**

# Generated application state and secrets.
.config/cursor/chats/**
.config/cursor/cli-config.json
# Cursor manages its bundled skills directly — don't let chezmoi fight it.
.cursor/skills-cursor/**
.config/raycast/ai/**
.config/raycast/config.json
.config/raycast/extensions/**
# Local Raycast dev extensions: ship source only. node_modules/dist are rebuilt
# in the target via `npm ci` (see each extension's README), never carried by chezmoi.
raycast-extensions/spam/node_modules/**
raycast-extensions/spam/dist/**
.config/zed/.tmp*
.config/zed/embeddings/**
.config/zed/prompts/**
.config/lnav/**
.config/atuin/atuin-receipt.json

