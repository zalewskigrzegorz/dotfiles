#!/usr/bin/env bash
# Install local code-indexing CLIs as uv tools (→ ~/.local/bin).
#   - serena-agent      : LSP-based semantic navigation MCP (oraios/serena)
#
# CocoIndex (`ccc`) REMOVED 2026-08-05: per-session `ccc mcp` loaded a local
# embedding model into its own Python fleet, and on multi-worktree work it
# re-indexed each worktree separately. With ~7 concurrent Claude sessions the
# wake-from-sleep thundering herd (8 serena + 22 cocoindex procs) starved
# WindowServer and froze the UI. Net cost > benefit, so it's gone. Serena stays.
#
# run_onchange: chezmoi re-runs this whenever the rendered content changes.

set -euo pipefail

# chezmoi runs hooks with a minimal PATH; surface brew + local bins.
for d in \
  "/opt/homebrew/bin" \
  "/home/linuxbrew/.linuxbrew/bin" \
  "${HOME}/.local/bin" \
; do
  [[ -d "$d" ]] && PATH="$d:$PATH"
done
export PATH

if ! command -v uv >/dev/null 2>&1; then
  echo "code-index-tools: uv not on PATH — skipping (brew bundle installs it)."
  exit 0
fi

echo "code-index-tools: installing serena-agent (uv tool)…"
# NOTE: temporarily pinned to Greg's fork branch that adds nushell (nu --lsp) support.
# Revert to `uv tool install -p 3.13 serena-agent` once the upstream PR merges + releases.
uv tool install -p 3.13 --reinstall \
  "git+https://github.com/zalewskigrzegorz/serena.git@feat/nushell-language-support"

# repl MCP runs as an installed tool, not `uvx`: every live `uvx` holds a shared
# lock on ~/.cache/uv, so with one per Claude session `uv cache prune` in
# disk-sweep always timed out (2026-10-12).
echo "code-index-tools: installing posit-mcp-repl (uv tool)…"
uv tool install --upgrade posit-mcp-repl

# mempalace + mempalace-mcp: the MCP entry calls `mempalace-mcp` from ~/.local/bin;
# a fresh Mac without it showed `Failed to reconnect to mempalace: ENOENT` (2026-10-19).
echo "code-index-tools: installing mempalace (uv tool)…"
uv tool install --upgrade mempalace

# Best-effort: drop a previously-installed cocoindex-code tool (removed 2026-08-05).
uv tool uninstall cocoindex-code >/dev/null 2>&1 || true

echo "code-index-tools: done."
