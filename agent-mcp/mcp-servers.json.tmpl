{
  "mcpServers": {
    "draw": {
      "type": "http",
      "url": "https://mcp.mrglaszki.com/excalidraw/mcp"
    },
    "Homey": {
      "type": "http",
      "url": "https://mcp.mrglaszki.com/homey/mcp"
    },
    "nushell": {
      "command": "{{ .chezmoi.homeDir }}/.cargo/bin/mcp-server-nu",
      "args": [
        "--nu-config",
        "{{ .chezmoi.homeDir }}/.config/nushell/config.nu",
        "--nu-env-config",
        "{{ .chezmoi.homeDir }}/.config/nushell/env.nu"
      ]
    },
    {{/* console-ninja + wallaby MCP stay out (removed 2026-08-05, re-checked
         2026-10-13): both read from the VS Code / Cursor extension, and Greg's
         editor is (neo)vim. Wallaby runs headless through the wallaby-cli skill
         (`wallaby-skill`); Console Ninja has no standalone mode. */}}
    "mcp-debugger": {
      "command": "npx",
      "args": ["-y", "@debugmcp/mcp-debugger", "stdio"]
    },
    {{/* posit-dev/mcp-repl — persistent Python REPL, 1 tool, embedded runtime
         (no Jupyter), sandboxed (network off, writes scoped to workspace).
         JS/Node REPL deliberately skipped 2026-08-05: nothing maintained exists
         (pydantic archived, jupyter-kernel-mcp dead); revisit ~2027-02. */}}
    "repl": {
      "command": "{{ .chezmoi.homeDir }}/.local/bin/posit-mcp-repl",
      "args": ["--interpreter", "python"]
    },
    {{/* playwright MCP REMOVED 2026-07-27 (was commented out since 2026-05-24). agent-browser covered every automation case, so the block went away along with the global @playwright/cli. This says nothing about Playwright as a test framework — the work repo's e2e suite and the `pwt` nushell helper are untouched. To bring the MCP back: "playwright": { "command": "npx", "args": ["@playwright/mcp@latest"] }.
    */}}
    {{/* Docker MCP Toolkit gateway DROPPED 2026-05-24. Hypothesis "Docker = less context" turned out false (the gateway loads all 48 tools into Claude's tool registry the same as N separate MCPs would). Browser automation goes through the agent-browser skill instead. To re-enable: uncomment and `docker mcp gateway run` (Docker Desktop must be on).
    "MCP_DOCKER": {
      "command": "docker",
      "args": ["mcp", "gateway", "run"]
    },
    */}}
    {{/* chrome-devtools DROPPED 2026-05-24. Required Node >= 20.19, mise had 20.18, so it failed to connect. agent-browser covers the same use cases faster. Re-enable after bumping Node + only if agent-browser turns out to be missing something concrete.
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    */}}
    "mempalace": {
      "command": "{{ .chezmoi.homeDir }}/.local/bin/mempalace-mcp"
    },
    {{/* jetbrains MCP REMOVED 2026-09-28 — DataGrip uninstalled (JamSQL covers
         SQL), no JetBrains IDE left for @jetbrains/mcp-proxy to talk to. */}}
    {{/* grafana + grafana-dashboards + cloudwatch are now project-scoped to the
         work monorepo's own team-tracked .mcp.json, so they no longer load in
         every repo via the global user scope. */}}
    "n8n-mcp": {
      "type": "http",
      "url": "https://n8n.mrglaszki.com/mcp-server/http",
      "headers": {
        "Authorization": {{ if lookPath "op" }}{{ printf "Bearer %s" (onepasswordRead (printf "op://%s/N8N_API_KEY/password" (index . "onePasswordVault" | default "Dotfiles"))) | quote }}{{ else }}"Bearer "{{ end }}
      }
    },
    {{/* Jam SQL Studio — AI-first DB client (macOS app, no brew cask; installed
         from downloads.jamsql.com). Local MCP server: read-only, maxRows 1000,
         query timeout 30s; port is persisted via preferredPort in the app's
         mcp-server-config.json. Token lives in 1P (Dotfiles/JAM_SQL). Queries
         run through the app so Greg sees them + results in the GUI. */}}
    "jamsql": {
      "type": "http",
      "url": "http://127.0.0.1:14507/mcp",
      "headers": {
        "Authorization": {{ if lookPath "op" }}{{ printf "Bearer %s" (onepasswordRead (printf "op://%s/JAM_SQL/password" (index . "onePasswordVault" | default "Dotfiles"))) | quote }}{{ else }}"Bearer "{{ end }}
      }
    },
    "hindsight": {
      "type": "http",
      "url": "http://192.168.50.10:8888/mcp/greg/"
    },
    {{- if eq .chezmoi.os "darwin" }}
    {{/* Clop (cask "clop") — image/video/PDF optimiser. The MCP server ships
         inside the app; "Enable MCP" must be on in Clop → Settings → MCP. */}}
    "clop": {
      "command": "/Applications/Clop.app/Contents/Helpers/ClopCLI",
      "args": ["mcp", "serve"]
    },
    {{/* Vimma (cask "vimma-browser/tap/vimma") — agent reaches only its "agent"
         workspace, every request is confirmed in Vimma. vimma-ctl has no prebuilt
         macOS binary yet: clone github.com/vimma-browser/vimma at the tag matching
         the cask, `cargo build --release` in tools/vimma-ctl, copy to ~/.local/bin.
         In Vimma: about:config vimma.control.enabled=true, then `:mcp on`.
         Agent tabs close when the MCP connection ends. */}}
    "vimma": {
      "command": "{{ .chezmoi.homeDir }}/.local/bin/vimma-ctl",
      "args": ["mcp"]
    },
    {{/* Browsentic (npm global, run_onchange_after_12) — drives the paired browser
         (Vimma) through its Bridge on 127.0.0.1:8765. Submits, uploads, captchas
         and tab switches are refused for MCP callers by design. */}}
    "browsentic": {
      "command": "/opt/homebrew/bin/browsentic",
      "args": ["mcp"]
    },
    {{- end }}
    {{/* Serena — 100% local LSP-based semantic-nav MCP, no cloud, no API key.
         CLI installed as a uv tool by run_onchange_after_26-code-index-tools.sh.tmpl.
         Absolute ~/.local/bin path (like the nushell MCP) so runtime resolution
         never depends on PATH order. Context flag is `claude-code`
         (`ide-assistant` is deprecated). Serena auto-downloads its own TS/JS
         language server on first use — no typescript-language-server needed.
         CocoIndex (`ccc`) was removed 2026-08-05 (per-session embedding fleet +
         per-worktree re-index cost > benefit); Serena is the only local
         code-intelligence server now. */}}
    "serena": {
      "command": "{{ .chezmoi.homeDir }}/.local/bin/serena",
      "args": ["start-mcp-server", "--context", "claude-code", "--project-from-cwd", "--open-web-dashboard", "false"]
    }
  }
}
