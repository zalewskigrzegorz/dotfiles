#!/usr/bin/env bash
{{- if eq .chezmoi.os "darwin" }}
# macOS system defaults captured from NeuroMancer on 2026-10-19, so a fresh Mac
# gets the same Dock, menu bar and Finder behaviour, plus sketchybar as a brew
# service (it replaces the hidden menu bar), colima as a brew service and the
# Docker CLI plugin links. Edit a value here and the run_onchange
# hash re-applies it.
set -eu

# Dock: hidden, tiny, on the right, no recents, no app-launch bounce.
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-time-modifier -float 1
defaults write com.apple.dock tilesize -int 16
defaults write com.apple.dock orientation -string right
defaults write com.apple.dock show-recents -bool false
defaults write com.apple.dock launchanim -bool false
defaults write com.apple.dock minimize-to-application -bool false
# Window manager (HyprMac): keep Spaces in a fixed order and don't group windows in Mission Control.
defaults write com.apple.dock mru-spaces -bool false
defaults write com.apple.dock expose-group-apps -bool false
defaults write com.apple.spaces spans-displays -bool true

# Menu bar hidden for sketchybar, also in full screen.
defaults write NSGlobalDomain _HIHideMenuBar -bool true
defaults write NSGlobalDomain AppleMenuBarVisibleInFullscreen -bool false
defaults write NSGlobalDomain NSAutomaticWindowAnimationsEnabled -bool false
defaults write NSGlobalDomain AppleInterfaceStyle -string Dark
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Finder and desktop.
defaults write com.apple.finder AppleShowAllFiles -bool true
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder FXPreferredViewStyle -string glyv
defaults write com.apple.WindowManager StandardHideDesktopIcons -bool true

# ctrl+space (60) and ctrl+opt+space (61) switch input sources once a second layout exists; herdr's prefix needs them.
# Takes effect after the next login or a toggle in System Settings → Keyboard Shortcuts → Input Sources.
for hk in 60:262144 61:786432; do
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "${hk%%:*}" "{ enabled = 0; value = { parameters = (32, 49, ${hk#*:}); type = standard; }; }"
done

# Clop watches CleanShot's Drive folder; MCP on so agents can drive it (server registered in agent-mcp).
defaults write com.lowtechguys.Clop imageDirs -array "~/Desktop" "~/Library/CloudStorage/GoogleDrive-maksim009@gmail.com/My Drive/Screenshots"
defaults write com.lowtechguys.Clop mcpEnabled -bool true
# One image per copy: accumulated clipboard images paste into Claude and Slack as several at once.
defaults write com.lowtechguys.Clop copyConsecutiveClipboardImages -bool false

# kindaVim enters normal mode on Esc, like nvim, Vimma, nushell and Claude Code. Read on its next launch.
defaults write mo.com.sleeplessmind.kindaVim enterNormalModeWith -string escape
# Off for apps with a vim of their own: Esc there belongs to Claude Code's vim mode and Vimma.
defaults write mo.com.sleeplessmind.kindaVim appsToIgnore -string '["dev.vimma.browser","com.mitchellh.ghostty"]'
defaults write mo.com.sleeplessmind.kindaVim KeyboardShortcuts_enterNormalMode -string '{"carbonModifiers":4096,"carbonKeyCode":33}'
defaults write mo.com.sleeplessmind.kindaVim sequenceCharacters -string jk
defaults write mo.com.sleeplessmind.kindaVim showCharactersWindow -bool true
defaults write mo.com.sleeplessmind.kindaVim charactersWindowContent -string mode
defaults write mo.com.sleeplessmind.kindaVim charactersWindowPosition -string aboveCaret

# Wooshy: toggle shortcut and look. Input coordinates stay out: they follow the monitor layout.
defaults write mo.com.sleeplessmind.Wooshy KeyboardShortcuts_toggleWith -string '{"carbonModifiers":4352,"carbonKeyCode":44}'
defaults write mo.com.sleeplessmind.Wooshy hazeOverWindowOpacity -float 0.479159
defaults write mo.com.sleeplessmind.Wooshy hazeOverWindowStyle -string fadeOutWholeScreen
defaults write mo.com.sleeplessmind.Wooshy inputBackgroundOpacity -float 0.9
defaults write mo.com.sleeplessmind.Wooshy inputBorderThickness -float 2
defaults write mo.com.sleeplessmind.Wooshy inputCornerRadius -float 9
defaults write mo.com.sleeplessmind.Wooshy inputPosition -string aboveInput
defaults write mo.com.sleeplessmind.Wooshy inputPreset -string wooshy
defaults write mo.com.sleeplessmind.Wooshy inputTextSize -float 16
defaults write mo.com.sleeplessmind.Wooshy targetsBorderStyle -string macOS26
defaults write mo.com.sleeplessmind.Wooshy targetsColor -string gsFlamboyantFuchsia

killall Dock Finder SystemUIServer 2>/dev/null || true

if [ -x /opt/homebrew/bin/brew ] && /opt/homebrew/bin/brew list sketchybar >/dev/null 2>&1; then
  /opt/homebrew/bin/brew services start sketchybar >/dev/null 2>&1 || echo "macos-defaults: brew services start sketchybar failed"
fi

# Docker CLI ignores brew's plugin dir, so `docker compose` is "unknown command" without these links.
mkdir -p "$HOME/.docker/cli-plugins"
for p in docker-compose docker-buildx; do
  if [ -e "/opt/homebrew/lib/docker/cli-plugins/$p" ]; then
    ln -sfn "/opt/homebrew/lib/docker/cli-plugins/$p" "$HOME/.docker/cli-plugins/$p"
  fi
done

# shortcut: a fresh Mac boots colima with its defaults (2 CPU, 2 GB); size it once with `colima stop && colima start --cpu 8 --memory 20 --disk 100`.
if [ -x /opt/homebrew/bin/brew ] && /opt/homebrew/bin/brew list colima >/dev/null 2>&1; then
  /opt/homebrew/bin/brew services start colima >/dev/null 2>&1 || echo "macos-defaults: brew services start colima failed"
fi
echo "macos-defaults: applied"
{{- end }}
