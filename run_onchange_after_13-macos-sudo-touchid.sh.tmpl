#!/usr/bin/env bash
{{- if eq .chezmoi.os "darwin" }}
# Touch ID for sudo, via /etc/pam.d/sudo_local (survives macOS updates, unlike
# /etc/pam.d/sudo). pam_reattach (brew "pam-reattach") makes it work inside
# herdr panes too. Needs the Brewfile installed first, hence stage 13.
set -eu

DST=/etc/pam.d/sudo_local
REATTACH=/opt/homebrew/lib/pam/pam_reattach.so
WANT="auth       optional       ${REATTACH}
auth       sufficient     pam_tid.so"

if [ ! -f "$REATTACH" ]; then
  echo "sudo-touchid: $REATTACH missing (brew install pam-reattach) — skipping."
  exit 0
fi

squash() { grep -v '^#' | tr -s ' \t' ' ' | sed 's/ *$//'; }
if [ -f "$DST" ] && [ "$(squash < "$DST")" = "$(printf '%s\n' "$WANT" | squash)" ]; then
  exit 0
fi

if [ ! -t 0 ] && ! sudo -n true 2>/dev/null; then
  echo "sudo-touchid: no TTY for sudo — run chezmoi apply from a terminal to enable Touch ID for sudo."
  exit 0
fi

printf '%s\n' "$WANT" | sudo tee "$DST" >/dev/null
echo "sudo-touchid: wrote $DST"
{{- end }}
