{
  "agent": "claude",
  "agents": {
    "claude": {
      "bin": "/Users/greg/.local/bin/claude",
      "model": "opus",
      "effort": "medium"
    }
  },
  "requireApproval": [
    "page.submitForm",
    "page.attachFile"
  ],
  "maxConcurrentRuns": 3,
  "theme": "midnight",
  "guardrails": {
    "unattended": "deny",
    "fence": true,
    "rules": {
      "file-download": "allow"
    }
  },
  "downloadTtlDays": 14,
  "pairing": {
    "mode": "auto"
  },
  "android": {
    "enabled": false
  }
}
