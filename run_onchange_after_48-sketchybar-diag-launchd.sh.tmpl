#!/usr/bin/env bash
# Tear down the com.greg.sketchybar-diag LaunchAgent. Gzyms replaced SketchyBar on 2026-10-30
# and has its own anomaly detector (~/Library/Logs/Gzyms/anomalies.jsonl) and Usage HUD (`gzyms hud`).
# bin/sketchybar-diag and bin/sketchybar-why stay for a manual fallback to SketchyBar. Mac-only.
#
# Version: 2026-10-30.1
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
launchctl bootout "gui/$(id -u)/com.greg.sketchybar-diag" 2>/dev/null || true
rm -f "$HOME/Library/LaunchAgents/com.greg.sketchybar-diag.plist"
echo "[ok] com.greg.sketchybar-diag removed (Gzyms replaced SketchyBar)"
{{ else -}}
exit 0
{{ end -}}
