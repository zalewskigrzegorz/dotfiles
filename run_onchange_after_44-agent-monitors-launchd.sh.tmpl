#!/usr/bin/env bash
# Install + (re)load the com.greg.agent-monitors LaunchAgent: reads idle tuios panes every 15 s
# via bin/agent-monitors and pushes the SketchyBar agent_monitors chip. Mac-only. Self-
# contained (emits the plist inline) so `chezmoi apply` reproduces it on a fresh
# machine — mirrors run_onchange_after_20's approach.
#
# Bump this version comment to force re-run when the plist/interval changes.
# Version: 2026-10-21.1
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
plist_dir="$HOME/Library/LaunchAgents"
plist_file="$plist_dir/com.greg.agent-monitors.plist"
mkdir -p "$plist_dir"

cat > "$plist_file" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.greg.agent-monitors</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/Code/dotfiles/bin/agent-monitors</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>/tmp/com.greg.agent-monitors.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.greg.agent-monitors.err</string>
</dict>
</plist>
PLIST

# load on a loaded job fails with "Input/output error" and keeps the old interval
launchctl bootout "gui/$(id -u)/com.greg.agent-monitors" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$plist_file"
echo "[ok] com.greg.agent-monitors loaded (poll every 15s)"
{{ else -}}
exit 0
{{ end -}}
