#!/usr/bin/env python3
"""Serve an HTML slide deck and drive it from anywhere — no macOS permissions involved.

    deck-serve <deck.html> [port]        # default port 8777

Then:
    open http://localhost:8777/          # the deck itself
    open http://<mac-ip>:8777/remote     # phone remote
    curl -s localhost:8777/next          # what the AeroSpace / Stream Deck binding calls

The deck holds an SSE connection to /events; every /next, /prev, /first, /last, /calm and
/goto/<n> hit is broadcast to it instantly. Works while focus is anywhere else, because
nothing is simulating keystrokes — the page is told directly.
"""
import json
import os
import queue
import socket
import sys
import threading
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

COMMANDS = {"next", "prev", "first", "last", "calm"}

subscribers: "list[queue.Queue]" = []
sub_lock = threading.Lock()
state = {"current": 1, "total": 0, "tag": ""}


def broadcast(payload: dict) -> int:
    with sub_lock:
        targets = list(subscribers)
    for q in targets:
        q.put(payload)
    return len(targets)


REMOTE_PAGE = """<!doctype html><html><head><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1,user-scalable=no">
<title>Deck remote</title><style>
:root{--bg:#181825;--panel:#232332;--line:#45475a;--fg:#f0f0ff;--mauve:#b347ff;--sky:#8be9fd}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;height:100vh;display:flex;flex-direction:column;gap:12px;padding:16px;
background:var(--bg);color:var(--fg);font:16px/1.4 ui-sans-serif,-apple-system,sans-serif}
#pos{text-align:center;font:600 15px ui-monospace,monospace;color:var(--sky);min-height:20px}
#tag{text-align:center;font-size:13px;color:#a6adc8;min-height:18px}
.row{display:flex;gap:12px;flex:1}
button{flex:1;background:var(--panel);color:var(--fg);border:1px solid var(--line);
border-radius:16px;font:600 20px ui-sans-serif,sans-serif;touch-action:manipulation}
button:active{background:var(--mauve);border-color:var(--mauve)}
.big{font-size:38px}
.small{flex:0 0 auto;padding:14px 18px;font-size:14px}
.bar{display:flex;gap:10px}
</style></head><body>
<div id=pos>—</div><div id=tag></div>
<div class="row">
  <button class=big onclick=go('prev')>&larr;</button>
  <button class=big onclick=go('next')>&rarr;</button>
</div>
<div class=bar>
  <button class=small onclick=go('first')>start</button>
  <button class=small onclick=go('calm')>calm</button>
  <button class=small onclick=go('last')>end</button>
</div>
<script>
function go(c){fetch('/'+c).catch(()=>{})}
async function poll(){
  try{const r=await fetch('/state');const s=await r.json();
    document.getElementById('pos').textContent=s.total?(s.current+' / '+s.total):'—';
    document.getElementById('tag').textContent=s.tag||'';
  }catch(e){}
  setTimeout(poll,900);
}
poll();
document.addEventListener('keydown',e=>{
  if(e.key==='ArrowRight')go('next'); if(e.key==='ArrowLeft')go('prev');
});
</script></body></html>"""


class Handler(SimpleHTTPRequestHandler):
    deck_file = "deck.html"

    def log_message(self, fmt, *args):  # keep the terminal usable
        pass

    def _send(self, code, body=b"", ctype="text/plain; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if body:
            self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?")[0].rstrip("/") or "/"

        if path == "/":
            self.path = "/" + self.deck_file
            return SimpleHTTPRequestHandler.do_GET(self)

        if path == "/remote":
            return self._send(200, REMOTE_PAGE.encode(), "text/html; charset=utf-8")

        if path == "/state":
            return self._send(200, json.dumps(state).encode(), "application/json")

        if path == "/events":
            return self.stream_events()

        cmd = path.lstrip("/")
        if cmd in COMMANDS:
            n = broadcast({"cmd": cmd})
            return self._send(200, f"{cmd} -> {n} listener(s)\n".encode())

        if cmd.startswith("goto/"):
            try:
                target = int(cmd.split("/", 1)[1])
            except ValueError:
                return self._send(400, b"goto needs a number\n")
            n = broadcast({"cmd": "goto", "n": target})
            return self._send(200, f"goto {target} -> {n} listener(s)\n".encode())

        return SimpleHTTPRequestHandler.do_GET(self)

    def do_POST(self):
        if self.path.split("?")[0] == "/state":
            length = int(self.headers.get("Content-Length") or 0)
            try:
                data = json.loads(self.rfile.read(length) or b"{}")
                state.update({k: data[k] for k in ("current", "total", "tag") if k in data})
            except Exception:
                pass
            return self._send(204)
        return self._send(404, b"not found\n")

    def stream_events(self):
        q: queue.Queue = queue.Queue()
        with sub_lock:
            subscribers.append(q)
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        try:
            self.wfile.write(b": connected\n\n")
            self.wfile.flush()
            while True:
                try:
                    payload = q.get(timeout=15)
                    self.wfile.write(f"data: {json.dumps(payload)}\n\n".encode())
                except queue.Empty:
                    self.wfile.write(b": keepalive\n\n")  # keep proxies and Safari happy
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            with sub_lock:
                if q in subscribers:
                    subscribers.remove(q)


def lan_ip() -> str:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.168.1.1", 1))
        return s.getsockname()[0]
    except Exception:
        return "127.0.0.1"
    finally:
        s.close()


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__.strip(), file=sys.stderr)
        return 64
    deck = os.path.abspath(sys.argv[1])
    if not os.path.isfile(deck):
        print(f"deck-serve: no such file: {deck}", file=sys.stderr)
        return 66
    port = int(sys.argv[2]) if len(sys.argv) > 2 else 8777

    os.chdir(os.path.dirname(deck))
    Handler.deck_file = os.path.basename(deck)

    server = ThreadingHTTPServer(("0.0.0.0", port), Handler)
    server.daemon_threads = True
    ip = lan_ip()
    print(f"deck   → http://localhost:{port}/")
    print(f"remote → http://{ip}:{port}/remote   (phone on the same wifi)")
    print(f"keys   → curl -s localhost:{port}/next   |   /prev /first /last /calm /goto/7")
    print("ctrl-c to stop")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
