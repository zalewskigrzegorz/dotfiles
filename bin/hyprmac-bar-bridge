#!/usr/bin/env python3
"""hyprmac-bar-bridge — feed sketchybar-watcher from HyprMac's log, which is the only place HyprMac exposes its state.

Writes ~/.cache/hyprmac-bar/state/{windows.json,focused} in aerospace's output format and sends the
watcher the same `workspace` / `window-changed` events aerospace's callbacks did.
Runs as launchd com.greg.hyprmac-bar. Window id -> app name comes from bin/hyprmac-cgwins.swift,
compiled to ~/.cache/hyprmac-bar/cgwins on first use. HyprMac has no CLI or events
(zacharytgray/HyprMac#44), so its log plus a SIGUSR1 state dump every minute is the source.
shortcut: parses HyprMac 0.18 log wording, a HyprMac update may change it; then fix the regexes.
"""
import json
import os
import re
import shutil
import signal
import subprocess
import threading

CGWINS_SRC = os.path.join(os.path.dirname(os.path.realpath(__file__)), "hyprmac-cgwins.swift")
CGWINS = os.path.expanduser("~/.cache/hyprmac-bar/cgwins")
OUT = os.path.expanduser("~/.cache/hyprmac-bar/state")  # per-user, not a shared /tmp path
WATCHER = os.path.expanduser("~/Code/dotfiles/bin/sketchybar-watcher/sketchybar-watcher")
NAMES = {1: "chat", 4: "term", 7: "code", 10: "notes", 2: "web", 5: "test", 8: "mail", 3: "media", 6: "misc", 9: "mac"}
DISPLAY = {"DELL U3225QE": "1", "Built-in Retina Display": "2", "C34H89x": "3"}  # aerospace monitor ids
PRED = 'subsystem == "com.zachgray.HyprMac" AND (category == "lifecycle" OR category == "orchestration")'

RX = [
    ("screen", re.compile(r"^screen=(.+?) visible=ws(\d+)")),
    ("switch", re.compile(r"switch: (.+?) ws(\d+)→ws(\d+)")),
    ("visible", re.compile(r"switch: ws(\d+) already visible on (.+)")),
    ("move", re.compile(r"(?:assignWindow|moveWindow): wid=(\d+) \S+ → ws(\d+)")),
    ("move", re.compile(r"assignNewWindow: .*\((\d+)\) frame=.* → ws(\d+)")),
    ("move", re.compile(r"window rule: \S+ \((\d+)\) pinned to ws(\d+)")),
    ("dump", re.compile(r"ws(\d+) home=(.+?) visible=\w+ assigned=\[([\d, ]*)\]")),
]

ws_of = {}       # window id -> HyprMac workspace number
focused = [None, None]  # [workspace number, screen name]
last = [None]    # kind of the previous line, to spot where a SIGUSR1 state dump starts


def apply(msg):
    """Update state from one log line; return 'focus', 'windows' or None."""
    for kind, rx in RX:
        m = rx.search(msg)
        if not m:
            continue
        prev, last[0] = last[0], kind
        if kind == "screen":
            if prev != "screen":  # a dump is the full truth: forget what earlier lines said
                ws_of.clear()
            return None
        if kind == "switch":
            focused[:] = [int(m.group(3)), m.group(1)]
            return "focus"
        if kind == "visible":
            focused[:] = [int(m.group(1)), m.group(2)]
            return "focus"
        if kind == "move":
            ws_of[m.group(1)] = int(m.group(2))
            return "windows"
        if kind == "dump":
            for wid in filter(None, (w.strip() for w in m.group(3).split(","))):
                ws_of[wid] = int(m.group(1))
            return "windows"
    last[0] = None
    return None


def resync():
    """HyprMac dumps its whole state to the log on SIGUSR1; ask for one now and every minute."""
    pid = subprocess.run(["pgrep", "-x", "HyprMac"], capture_output=True, text=True).stdout.split()
    if pid:
        os.kill(int(pid[0]), signal.SIGUSR1)
    threading.Timer(60, resync).start()


def build_cgwins():
    if os.path.exists(CGWINS) and os.path.getmtime(CGWINS) >= os.path.getmtime(CGWINS_SRC):
        return
    os.makedirs(os.path.dirname(CGWINS), exist_ok=True)
    subprocess.run(["swiftc", "-O", "-o", CGWINS, CGWINS_SRC], check=True)


def write():
    apps = json.loads(subprocess.run([CGWINS], capture_output=True, text=True).stdout or "{}")
    rows = [{"workspace": NAMES.get(ws, str(ws)), "app-name": apps[wid]}
            for wid, ws in sorted(ws_of.items()) if wid in apps]
    for wid in [w for w in ws_of if w not in apps]:  # closed windows
        del ws_of[wid]
    os.makedirs(OUT, exist_ok=True)
    with open(f"{OUT}/windows.json.tmp", "w") as f:
        json.dump(rows, f)
    os.replace(f"{OUT}/windows.json.tmp", f"{OUT}/windows.json")
    with open(f"{OUT}/focused", "w") as f:
        f.write(NAMES.get(focused[0], "") + "\n")


def notify(kind):
    if kind == "focus" and focused[0]:
        args = ["workspace", f"FOCUSED_WORKSPACE={NAMES.get(focused[0], focused[0])}"]
        if focused[1] in DISPLAY:
            args.append(f"FOCUSED_DISPLAY={DISPLAY[focused[1]]}")
    else:
        args = ["window-changed"]
    subprocess.run([WATCHER, "notify", "--event", *args], capture_output=True)


def lines(cmd):
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    for line in p.stdout:
        try:
            msg = json.loads(line.rstrip(",\n")).get("eventMessage", "")
        except ValueError:
            continue
        yield msg


def main():
    build_cgwins()
    # recent lines give the focused workspace; the first state dump fills in the windows
    for msg in lines(["/usr/bin/log", "show", "--last", "30m",
                      "--info", "--style", "ndjson", "--predicate", PRED]):
        apply(msg)
    write()
    notify("focus")
    notify("windows")
    threading.Timer(2, resync).start()
    for msg in lines(["/usr/bin/log", "stream", "--info", "--style", "ndjson", "--predicate", PRED]):
        kind = apply(msg)
        if kind:
            write()
            notify(kind)


if __name__ == "__main__":
    try:
        main()
    finally:
        shutil.rmtree(OUT, ignore_errors=True)
        os._exit(0)  # the resync timer thread would keep the process alive
