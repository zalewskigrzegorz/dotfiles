#!/bin/bash
# Show PNGs with the kitty graphics protocol, stacked, then wait for a key.
# shot-pane runs it in a `tuios popup`: tuios drops the kitty images Claude Code
# draws in a pane (U=1 placeholders), but shows ones placed directly with i=.
# Usage: kitty-show <file.png>...
set -eu
[ $# -gt 0 ] || { echo "usage: kitty-show <file.png>..." >&2; exit 2; }
rows=$(( ($(tput lines) - 1 - 2 * $#) / $# ))
[ "$rows" -lt 3 ] && rows=3
id=$(( RANDOM + 1 ))
for f in "$@"; do
  printf '%s\n' "$(basename "$f")"
  data=$(base64 < "$f" | tr -d '\n')
  first=1
  while [ -n "$data" ]; do
    chunk=${data:0:4096}
    data=${data:4096}
    more=0; [ -n "$data" ] && more=1
    if [ "$first" = 1 ]; then
      # q=2: no reply from the terminal, so nothing lands on the next prompt.
      printf '\033_Ga=T,i=%s,q=2,f=100,r=%s,m=%s;%s\033\\' "$id" "$rows" "$more" "$chunk"
      first=0
    else
      printf '\033_Gm=%s;%s\033\\' "$more" "$chunk"
    fi
  done
  printf '\n'
  id=$(( id + 1 ))
done
read -rsn1
