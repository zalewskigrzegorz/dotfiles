#!/usr/bin/env bash
# sync — chezmoi apply/update wrapper that loads the 1Password service-account
# token *only* for the duration of this invocation.
#
# Why: interactive Mac shells no longer eager-export OP_SERVICE_ACCOUNT_TOKEN
# (it would hijack every `op` call away from the user's personal/Touch ID
# session). chezmoi still needs the token to render `onepasswordRead` templates
# (mcp-servers.json.tmpl etc.). This wrapper bridges the two — loads the token
# from ~/.config/op/sa-token, exec's chezmoi, env var dies with the subprocess.
#
# Usage:
#   sync                  → sync back, then chezmoi apply
#   sync back             → copy what changed on disk (settings clicked in an app) into the repo
#   sync update           → chezmoi update (git pull + apply, used on lab)
#   sync <other> [args]   → chezmoi <other> [args]   (passthrough)
#
# Source of truth: ~/Code/dotfiles/bin/sync (chezmoi-managed).
# Replaces the older standalone ~/bin/sync — delete that file once this lives
# on PATH (the dotfiles bin/ dir is prepended earlier than ~/bin per env.nu).

set -euo pipefail

# Load service-account token if available and not already in env.
sa_token="${HOME}/.config/op/sa-token"
if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" && -r "$sa_token" ]]; then
  OP_SERVICE_ACCOUNT_TOKEN=$(tr -d '[:space:]' < "$sa_token")
  export OP_SERVICE_ACCOUNT_TOKEN
fi

# Make sure brew bins are reachable — chezmoi needs `op`, `gh`, etc. on PATH,
# and this script may be invoked from a stripped env (cron, ssh, Raycast).
for d in \
  /opt/homebrew/bin \
  /home/linuxbrew/.linuxbrew/bin \
  "${HOME}/.linuxbrew/bin" \
  /usr/local/bin \
  "${HOME}/.local/bin"
do
  [[ -d "$d" ]] && PATH="$d:$PATH"
done
export PATH

if ! command -v chezmoi >/dev/null 2>&1; then
  echo "chezmoi not found on PATH" >&2
  exit 127
fi

# Dispatch
#
# --force on apply/update: chezmoi refuses to overwrite a target that changed
# since it last wrote it and falls back to a TTY prompt — which fails outright
# in hooks/cron/Raycast. Claude Code rewrites ~/.claude/settings.json on every
# /config, model switch or plugin toggle, so without --force that file (and
# anything else an app owns) stays permanently drifted. The repo is the source
# of truth for what it sends; a change made on disk is first taken into it by
# `back`, so --force no longer throws a clicked setting away. Use bare
# `chezmoi apply` when you want the prompts.

# The first `chezmoi status` column is a change on disk since chezmoi last wrote
# the file (a click in an app's settings); the second, what apply would change
# (a commit in the repo). Only the first is taken back.
back() {
  local line target src taken=()
  while IFS= read -r line; do
    [[ "${line:0:1}" == M ]] || continue
    target="$HOME/${line:3}"
    # A directory row is only a mode change (0700 vs 0755): apply puts the repo's
    # mode back. Scanning it would walk all of ~/.config, colima's 47 GB disk included.
    [[ -d "$target" ]] && continue
    src="$(chezmoi source-path "$target")"
    case "$(basename "$src")" in
      *.tmpl | modify_*)
        # A template can't be re-added: show the change to copy by hand.
        echo "to copy by hand into ${src#"$HOME"/}:"
        # The rendered side may hold secrets from 1Password: print the diff
        # only to a terminal, never into a log or an agent's transcript.
        if [[ -t 1 ]]; then
          chezmoi diff --reverse "$target" || true
        else
          echo "  $(chezmoi diff "$target" | grep -c '^[+-][^+-]') changed lines; see: chezmoi diff --reverse $target"
        fi
        ;;
      *)
        # A plain tracked file can hold a token an app wrote (gh's hosts.yml
        # without the keychain): scan it with both rule sets, and keep it out
        # of the repo when either finds one or cannot run.
        if ! command -v gitleaks >/dev/null ||
          ! gitleaks dir "$target" --no-banner -l fatal -c "$(chezmoi source-path)/.gitleaks.toml" >/dev/null ||
          ! gitleaks dir "$target" --no-banner -l fatal -c "$HOME/.local/state/dotfiles/secrets/gitleaks-private.toml" >/dev/null; then
          echo "not taken, may hold a secret: ${line:3}" >&2
          continue
        fi
        chezmoi re-add "$target"
        taken+=("$src")
        ;;
    esac
  done < <(chezmoi status)
  # Commit these like any other change; other agents' dirty files stay out of the list.
  ((${#taken[@]})) && git -C "$(chezmoi source-path)" diff --stat -- "${taken[@]}"
  return 0
}

case "${1:-apply}" in
  update)
    # No `back` here: the lab's source checkout is never committed from, and a
    # dirty one would stop the pull.
    shift
    exec chezmoi update --force "$@"
    ;;
  back)
    back
    ;;
  apply)
    shift 2>/dev/null || true
    back
    exec chezmoi apply --force "$@"
    ;;
  *)
    exec chezmoi "$@"
    ;;
esac
