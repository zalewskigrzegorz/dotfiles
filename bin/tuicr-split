#!/usr/bin/env bash
# tuicr-split — open tuicr in a tuios split under the calling agent's pane and
# block until it exits. tuicr upstream ships wrappers for tmux/zellij/herdr/cmux
# only; this is the tuios one, used by g-pr-review.
#
#   tuicr-split <dir> [tuicr args...]      e.g. tuicr-split . pr 1234
#
# Prints `window=<id>` first, so a caller running this in the background can
# find the pane, then `exit=<code>` when tuicr quits.
set -euo pipefail

dir="${1:?usage: tuicr-split <dir> [tuicr args...]}"
shift
[ -n "${TUIOS_PANE_ID:-}" ] || { echo "tuicr-split: not in a tuios pane (TUIOS_PANE_ID unset)" >&2; exit 2; }
command -v tuicr >/dev/null || { echo "tuicr-split: tuicr not installed (brew install tuicr)" >&2; exit 2; }
dir="$(cd "$dir" && pwd)"

# The pane runs nushell: `;` chains, single quotes keep each word literal, so a
# quote or a control char (newline = Enter) would break out; refuse those.
for a in "$dir" "$@"; do
  [[ "$a" != *"'"* && "$a" != *[[:cntrl:]]* ]] || { echo "tuicr-split: refusing quote/control char in: $a" >&2; exit 2; }
done

w="$(tuios split-window horizontal -w "$TUIOS_PANE_ID" --name tuicr --json | jq -r '.window_id // empty')" || true
if [ -n "$w" ]; then
  echo "window=$w"
  args=""
  for a in "$@"; do args+=" '$a'"; done
  tuios send-text -w "$w" "cd '$dir'; tuicr$args; exit
"
else
  # A detached session (a workctl review tab) has no client, so split-window
  # refuses; new-window works without one. Greg is not looking there: tell the Inbox.
  s=(${TUIOS_SESSION:+-s "$TUIOS_SESSION"})
  ws="$(tuios get-window "${s[@]}" "$TUIOS_PANE_ID" --json | jq -r '.workspace // empty')" || true
  w="$(tuios new-window "${s[@]}" tuicr ${ws:+--workspace "$ws"} --cwd "$dir" --no-focus --print-id -- tuicr "$@")" || true
  [ -n "$w" ] || { echo "tuicr-split: new-window returned no id" >&2; exit 1; }
  echo "window=$w"
  tuios send-agent-message "${s[@]}" -w human --from "$TUIOS_PANE_ID" --subject "tuicr czeka w sesji ${TUIOS_SESSION:-?}" \
    "Review otwarty w oknie tuicr (sesja ${TUIOS_SESSION:-?}, prefix+w). Wyjdź z tuicr, żeby agent poszedł dalej." >/dev/null || true
fi

tuios wait-for window-exit ${TUIOS_SESSION:+-s "$TUIOS_SESSION"} -w "$w" --timeout "${TUICR_SPLIT_TIMEOUT_MS:-7200000}" --json | jq -r '"exit=\(.exit_code // "?")"'
# A new-window program leaves its window behind after it exits; the split's shell is already gone.
tuios close-window ${TUIOS_SESSION:+-s "$TUIOS_SESSION"} "$w" >/dev/null 2>&1 || true
