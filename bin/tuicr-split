#!/usr/bin/env bash
# tuicr-split — open tuicr on its own tuios workspace (the first empty one after
# the calling agent's) and block until it exits. Greg keeps the agent on one
# workspace and tuicr on the next. tuicr upstream ships wrappers for
# tmux/zellij/herdr/cmux only; this is the tuios one, used by g-pr-review.
#
#   tuicr-split <dir> [tuicr args...]      e.g. tuicr-split . pr 1234
#
# Prints `window=<id>` first, so a caller running this in the background can
# find the pane, then `exit=<code>` when tuicr quits.
set -euo pipefail

dir="${1:?usage: tuicr-split <dir> [tuicr args...]}"
shift
[ -n "${TUIOS_PANE_ID:-}" ] || { echo "tuicr-split: not in a tuios pane (TUIOS_PANE_ID unset)" >&2; exit 2; }
command -v tuicr >/dev/null || { echo "tuicr-split: tuicr not installed (brew install tuicr)" >&2; exit 2; }
dir="$(cd "$dir" && pwd)"

s=(${TUIOS_SESSION:+-s "$TUIOS_SESSION"})
own="$(tuios get-window "${s[@]}" "$TUIOS_PANE_ID" --json | jq -r '.workspace // empty')" || true
ws="$(tuios list-workspaces "${s[@]}" --json | jq -r --argjson own "${own:-0}" \
  '[.workspaces[] | select(.window_count == 0 and .workspace > $own) | .workspace] | first // empty')" || true
ws="${ws:-$own}"

w="$(tuios new-window "${s[@]}" tuicr ${ws:+--workspace "$ws"} --cwd "$dir" --no-focus --print-id -- tuicr "$@")" || true
[ -n "$w" ] || { echo "tuicr-split: new-window returned no id" >&2; exit 1; }
echo "window=$w"
[ "$ws" != "$own" ] && tuios set-workspace-name "${s[@]}" "$ws" tuicr >/dev/null 2>&1 || true
tuios send-agent-message "${s[@]}" -w human --from "$TUIOS_PANE_ID" --subject "tuicr czeka na workspace ${ws:-?} (${TUIOS_SESSION:-?})" \
  "Review otwarty w oknie tuicr na workspace ${ws:-?}. Wyjdź z tuicr, żeby agent poszedł dalej." >/dev/null || true

tuios wait-for window-exit "${s[@]}" -w "$w" --timeout "${TUICR_SPLIT_TIMEOUT_MS:-7200000}" --json | jq -r '"exit=\(.exit_code // "?")"' || true
# A new-window program leaves its window behind after it exits.
tuios close-window "${s[@]}" "$w" >/dev/null 2>&1 || true
[ "$ws" != "$own" ] && tuios set-workspace-name "${s[@]}" "$ws" >/dev/null 2>&1 || true
