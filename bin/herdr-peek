#!/usr/bin/env bash
# herdr-peek — read a herdr pane's recent scrollback, so Claude can see what a
# command or an agent did without Greg pasting.
#
#   herdr-peek            # current workspace's shell pane (see a command's output)
#   herdr-peek -n 100     # more lines
#   herdr-peek 8          # workspace number 8's AGENT pane (statusline "▸8") — what that agent reported
#   herdr-peek wM         # same, by workspace id
#   herdr-peek wM:p3      # an exact pane, verbatim
#
# A bare number is the workspace "number" from `herdr workspace list` — the same
# index herdr shows in the tab strip / statusline (▸8). It resolves to that
# workspace's agent pane, because that is what "look what the agent reported"
# means. No arg = the CURRENT workspace's shell pane (a plain nu pane), to read
# the output of a command Greg just ran.
export PATH="/opt/homebrew/bin:$PATH"
HERDR="${HERDR_BIN:-herdr}"
command -v "$HERDR" >/dev/null 2>&1 || HERDR=/opt/homebrew/bin/herdr

N=25
TARGET=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n) N="${2:-25}"; shift 2 ;;
    -n*) N="${1#-n}"; shift ;;
    *) TARGET="$1"; shift ;;
  esac
done

# An explicit pane id (w<ws>:p<n>) is used verbatim — no lookup.
if printf '%s' "$TARGET" | grep -qE '^w[^:]+:p'; then
  PANE="$TARGET"
else
  PANE=$( { "$HERDR" workspace list 2>/dev/null; echo '---HERDR-SPLIT---'; "$HERDR" pane list 2>/dev/null; } \
    | HERDR_WS="${HERDR_WORKSPACE_ID:-}" HERDR_ME="${HERDR_PANE_ID:-}" HERDR_TARGET="$TARGET" python3 -c '
import json, os, sys

raw = sys.stdin.read()
ws_raw, _, pane_raw = raw.partition("---HERDR-SPLIT---")
try:
    workspaces = json.loads(ws_raw)["result"]["workspaces"]
    panes = json.loads(pane_raw)["result"]["panes"]
except Exception:
    sys.exit(0)

me = os.environ.get("HERDR_ME", "")
target = os.environ.get("HERDR_TARGET", "").strip()

if not target:
    # No target: the current workspace, and its SHELL pane (see a command output).
    ws_id = os.environ.get("HERDR_WS", "")
    want_agent = False
else:
    # A workspace ref: a bare number (workspace "number", the ▸N in the statusline)
    # or a workspace id. Its AGENT pane — what the agent over there reported.
    ws_id = ""
    if target.isdigit():
        n = int(target)
        for w in workspaces:
            if w.get("number") == n:
                ws_id = w.get("workspace_id", "")
                break
    else:
        ws_id = target
    want_agent = True

if not ws_id:
    sys.exit(0)

cands = [p for p in panes if p.get("workspace_id") == ws_id and p.get("pane_id") != me]
# Shell panes report agent_status "unknown"; agents report idle/working/blocked/done.
agents = [p for p in cands if p.get("agent_status") not in (None, "unknown")]
shells = [p for p in cands if p.get("agent_status") == "unknown"]
pick = (agents or shells) if want_agent else (shells or agents)
if not pick:
    pick = cands
if pick:
    print(pick[0]["pane_id"])
')
fi

if [ -z "$PANE" ]; then
  if [ -n "$TARGET" ]; then
    echo "herdr-peek: no pane found for '$TARGET' (not a live workspace number/id). Try: herdr workspace list"
  else
    echo "herdr-peek: no shell pane found in this workspace (HERDR_WORKSPACE_ID=${HERDR_WORKSPACE_ID:-unset}). Pass one: herdr-peek <N|w|w:p>"
  fi
  exit 0
fi
"$HERDR" pane read "$PANE" --source recent --lines "$N"
