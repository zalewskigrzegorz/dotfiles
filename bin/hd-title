#!/usr/bin/env bash
# hd-title "<text>" — set the CURRENT Claude session's tab/title to <text>.
# hd-title --clear  — clear the tuios workspace label and window name (the store is the caller's).
#
# One writer for three surfaces, kept in sync:
#   1. the tuios workspace label of this window   (plain text — no colour glyph)
#   2. the tuios window name   (the rail's agent row draws it)
#   3. a shared title store   (read by the statusline's win_seg)
#
# Why no colour on the label: an ANSI code or emoji dot in it would eat the
# narrow tab strip and rail. So the per-session COLOUR lives only in the
# statusline (win_seg, ANSI, free), and the label keeps the full width for
# readable text. Only the TEXT changes across checkpoints.
#
# Invoked by: the tuios-claude-title Stop hook (Haiku titles) and, as an
# override, the agent itself. Idempotent, non-blocking.
set -u

text="${1:-}"
[ -n "$text" ] || { echo "usage: hd-title <text> | --clear" >&2; exit 2; }

if [ "$text" != "--clear" ]; then
  sid="${CLAUDE_CODE_SESSION_ID:-}"
  title_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/claude-session-title"
  mkdir -p "$title_dir" 2>/dev/null
  # 1) shared store — the statusline reads this by <sid> and colours it per-session.
  [ -n "$sid" ] && printf '%s' "$text" > "$title_dir/$sid" 2>/dev/null
fi

# 2) tuios workspace label (only inside a tuios pane): the workspace this window is on.
if [ "${TUIOS_ENV:-}" = "1" ] && [ -n "${TUIOS_PANE_ID:-}" ]; then
  export PATH="$PATH:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin"
  if command -v tuios >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    t=""
    if [ "$text" != "--clear" ]; then
      # Trim to keep the tab strip / rail scannable. Tune via CLAUDE_TUIOS_TITLE_MAX.
      max="${CLAUDE_TUIOS_TITLE_MAX:-30}"
      t="$text"
      [ "${#t}" -gt "$max" ] && t="${t:0:$((max - 1))}…"
    fi
    # The rail's agent row draws the window name, which workctl set to "claude review".
    # An empty name hands it back to the program's own title.
    tuios set-window -w "$TUIOS_PANE_ID" --name "$t" >/dev/null 2>&1 || true
    ws=$(tuios get-window "$TUIOS_PANE_ID" --json 2>/dev/null | jq -r '.workspace // empty' 2>/dev/null)
    if [ -n "$ws" ]; then
      if [ -z "$t" ]; then
        tuios set-workspace-name "$ws" >/dev/null 2>&1 || true
      else
        tuios set-workspace-name "$ws" "$t" >/dev/null 2>&1 || true
      fi
    fi
  fi
fi

exit 0
