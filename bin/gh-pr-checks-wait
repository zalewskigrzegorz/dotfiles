#!/bin/zsh
# gh-pr-checks-wait <pr> [--timeout <s>] [--interval <s>] [--ignore <regex>]... [-R owner/repo]
#
# Watch every check on a PR. Prints one status line per interval
# (`19:21:04  pass=12 fail=0 pending=3 | pending: e2e, build`) so a tuios bg
# pane shows progress, then the final verdict. `gh pr checks --watch` prints
# nothing without a TTY until it ends, so its pane stayed empty (2026-10-27).
# Pending checks matching --ignore (default `Visual review`, which waits for a
# human click) don't hold the wait: two 30-min timeouts on it (c0cc0722).
# All-pass counts only after two consecutive reads with the same check count:
# 4 checks were registered at first, 31 a minute later (2b9de962, cdcb5b8a).
# A pending /E2E/i check for 3+ min with no e2e-pr.yml run on the head sha means
# the label event never started it: one line, exit 5, labels are never touched.
# Exit: 0 all passed, 1 on the first failed check (others may still run:
# 50 min on pass=26 fail=1 pending=2 hid a red check, 5cdaf331), 4 timeout,
# 5 E2E never started.
# Keep any outer `timeout` above --timeout (default 2700 s) so exit 4 is seen.
set -u
E2E_GRACE=${E2E_GRACE:-180}
PR=""; TIMEOUT=2700; INTERVAL=60; REPO=(); IGNORE="Visual review"
usage() { echo "usage: gh-pr-checks-wait <pr> [--timeout <s>] [--interval <s>] [--ignore <regex>]... [-R owner/repo]" >&2; exit 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    --timeout) shift; TIMEOUT=$1 ;;
    --interval) shift; INTERVAL=$1 ;;
    --ignore) shift; IGNORE="$IGNORE|$1" ;;
    -R) shift; REPO=(-R "$1") ;;
    -*) usage ;;
    *) PR=$1 ;;
  esac
  shift
done
[ -n "$PR" ] || usage

deadline=$(( $(date +%s) + TIMEOUT ))
last_total=0; ok_total=-1; e2e_since=0; e2e_checked=0
while :; do
  # gh exits 8 while checks are pending; the JSON is still complete
  json=$(gh pr checks "${REPO[@]}" "$PR" --json name,bucket,link 2>/dev/null)
  if [ -z "$json" ]; then
    echo "$(date +%T)  no checks yet"
  else
    line=$(printf '%s' "$json" | jq -r '
      def n(b): map(select(.bucket == b)) | length;
      "pass=\(n("pass")) fail=\(n("fail")) pending=\(n("pending"))"
      + (map(select(.bucket == "pending") | .name) | if length > 0 then " | pending: " + join(", ") else "" end)')
    echo "$(date +%T)  $line"
    total=$(printf '%s' "$json" | jq 'length')
    [ "$last_total" -gt 0 ] && [ "$total" -gt "$last_total" ] && echo "check count grew: $last_total -> $total"
    last_total=$total
    failed=$(printf '%s' "$json" | jq -r '.[] | select(.bucket == "fail") | "failure \(.name) \(.link)"')
    [ -n "$failed" ] && { echo "$failed"; exit 1; }
    pending=$(printf '%s' "$json" | jq --arg re "$IGNORE" '[.[] | select(.bucket == "pending" and (.name | test($re) | not))] | length')
    e2e_pending=$(printf '%s' "$json" | jq '[.[] | select(.bucket == "pending" and (.name | test("E2E"; "i")))] | length')
    if [ "$e2e_pending" -gt 0 ]; then
      [ "$e2e_since" -eq 0 ] && e2e_since=$(date +%s)
      if [ "$e2e_checked" -eq 0 ] && [ $(( $(date +%s) - e2e_since )) -ge "$E2E_GRACE" ]; then
        e2e_checked=1
        sha=$(gh pr view "${REPO[@]}" "$PR" --json headRefOid -q .headRefOid 2>/dev/null)
        runs=$(gh run list "${REPO[@]}" --commit "$sha" --workflow e2e-pr.yml --json databaseId 2>/dev/null)
        [ -n "$sha" ] && [ "$runs" = "[]" ] && { echo "E2E nie wystartowało na ${sha:0:9}: zdejmij i dodaj run_e2e"; exit 5; }
      fi
    else
      e2e_since=0
    fi
    if [ "$pending" -eq 0 ]; then
      if [ "$ok_total" -eq "$total" ]; then
        manual=$(printf '%s' "$json" | jq -r '[.[] | select(.bucket == "pending") | .name] | join(", ")')
        [ -n "$manual" ] && echo "only manual checks pending: $manual"
        echo "success: all checks passed"; exit 0
      fi
      ok_total=$total
    else
      ok_total=-1
    fi
  fi
  [ "$(date +%s)" -ge "$deadline" ] && { echo "timeout after ${TIMEOUT}s, checks still pending" >&2; exit 4; }
  sleep "$INTERVAL"
done
