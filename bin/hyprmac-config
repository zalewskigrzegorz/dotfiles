#!/usr/bin/env python3
"""hyprmac-config — merge Greg's HyprMac keybinds, app pins and floating apps into its live config.

In config.json `keybinds`, `windowRules`, `excludedBundleIDs`, `workspaceNames` and `hyprKey` are
ours; in monitor-config.json `workspaceMonitors`, `outerPaddingPerMonitor` and `statusExport*`. Everything set in
HyprMac's own Settings (gaps, focus border, dimming, ...) stays as it is, and so does a chord or
app pin added there on a combo / app this script does not use. HyprMac is quit before the write
and started again after it; the old file goes to ~/.local/state/hyprmac/backups first.

  hyprmac-config            merge, restart HyprMac
  hyprmac-config --dry-run  print both merged files, change nothing
"""
import json
import os
import shutil
import subprocess
import sys
import time

H, S, O, CTRL, C = 1, 2, 4, 8, 16  # hypr, shift, option, control, command (ModifierFlags bits)
K = dict(h=4, j=38, k=40, l=37, f=3, m=46, s=1, t=17, w=13, y=16, u=32, r=15, c=8,
         slash=44, minus=27, equal=24, tab=48, space=49, ret=36,
         semicolon=41, quote=39, comma=43, period=47, lbracket=33, rbracket=30, backslash=42)
DIGITS = [18, 19, 20, 21, 23, 22, 26, 28, 25, 29]  # keys 1..9, 0
BIN = os.path.expanduser("~/Code/dotfiles/bin")
LIVE = os.path.expanduser("~/Library/Application Support/HyprMac/config.json")  # symlink into iCloud Drive
MONITORS = os.path.expanduser("~/Library/Application Support/HyprMac/monitor-config.json")  # local, not synced

# Top padding per monitor so tiles start just under sketchybar (36pt on the externals, Greg picked 37);
# the laptop keeps outerPadding. A side set in Settings wins.
OUTER_PADDING = {"DELL U3225QE": {"top": 37}, "C34H89x": {"top": 37}}

# Key N = workspace N, names and monitors as in aerospace. Dell 1-5 (left hand): its deep blacks
# keep text sharp for chat and code. Ultrawide 6-9 (right hand, browsers from 6): media, meetings,
# manual testing. Laptop 0: helper screen, shared in calls. A monitor that is not connected leaves
# its workspaces on HyprMac's formula home, so the laptop alone gets all ten; aerospace fell back
# to the other external, HyprMac has no fallback list.
WS = dict(chat=1, term=2, code=3, misc=4, notes=5, web=6, media=7, test=8, mail=9, mac=10)
WS_MONITORS = {"DELL U3225QE": [1, 2, 3, 4, 5], "C34H89x": [6, 7, 8, 9], "Built-in Retina Display": [10]}
# Numbers this script wrote before 0.19 (workspace N on screen (N-1) % 3). Names and pins still on
# them are ours, not Settings', so merge() renumbers them instead of keeping them.
OLD_WS = dict(chat=1, term=4, code=7, notes=10, web=2, test=5, mail=8, media=3, misc=6, mac=9)

PINS = {  # aerospace on-window-detected rules by bundle ID; some apps are not installed right now
    "chat": ["com.tinyspeck.slackmacgap", "com.hnc.Discord", "net.whatsapp.WhatsApp",
             "net.coldx.App-for-WhatsApp-setapp", "com.apple.MobileSMS", "com.apple.FaceTime"],
    "term": ["com.mitchellh.ghostty", "com.apple.Terminal", "com.googlecode.iterm2", "net.kovidgoyal.kitty"],
    "code": ["com.microsoft.VSCode", "dev.zed.Zed", "com.jetbrains.datagrip", "com.sql-studio.app",
             "com.docker.docker", "com.ScooterSoftware.BeyondCompare"],
    "notes": ["md.obsidian", "notion.id", "com.apple.Notes", "com.apple.reminders"],
    "web": ["dev.vimma.browser", "ai.perplexity.comet", "com.apple.Safari", "app.zen-browser.zen"],
    "test": ["org.mozilla.firefox", "org.mozilla.firefoxdeveloperedition", "com.insomnia.app",
             "com.luckymarmot.Paw", "com.proxyman.NSProxy-setapp"],
    "mail": ["com.readdle.SparkDesktop", "com.apple.mail", "com.apple.iCal", "com.cron.electron",
             "com.flexibits.fantastical2.mac", "info.eurocomp.Timing-setapp"],
    "media": ["com.spotify.client", "com.colliderli.iina", "com.apple.Music", "com.apple.garageband10",
              "com.apple.iMovieApp"],
    "misc": ["com.apple.ActivityMonitor", "com.elgato.StreamDeck", "com.macpaw.CleanMyMac-setapp",
             "com.google.drivefs", "com.google.drivefs.shortcuts.docs", "com.google.drivefs.shortcuts.sheets",
             "com.google.drivefs.shortcuts.slides", "com.insta360.linkcontroller", "com.apple.Keynote",
             "com.apple.Numbers", "com.apple.Pages", "com.adriangranados.wifiexplorer-setapp",
             "org.upscayl.Upscayl"],
    "mac": ["com.dygmalab.bazecor"],
}
# aerospace `layout floating` by app; its title rules (PiP, Slack huddle) have no HyprMac equivalent.
FLOAT = ["co.boomvision.boom-setapp", "com.getcleanshot.app-setapp", "mo.com.sleeplessmind.kindaVim"]

binds = []


def bind(key, mods, action):
    binds.append({"action": action, "keyCode": key, "modifiers": mods})


# Every action gets a chord, or mergeNewDefaults injects HyprMac's own onto bare hypr+<key>.
for d, k in zip(["left", "down", "up", "right"], "hjkl"):
    bind(K[k], H, {"focusDirection": {"_0": d}})
    bind(K[k], H | S, {"swapDirection": {"_0": d}})
for n, key in enumerate(DIGITS, 1):
    bind(key, H, {"switchDesktop": {"_0": n}})
    bind(key, H | S, {"moveToWorkspaceAndFollow": {"_0": n}})  # the one Greg uses: 2 keys + digit
    bind(key, H | O | S, {"moveToDesktop": {"_0": n}})
bind(K["minus"], H, {"resizeDirection": {"_0": "left"}})
bind(K["equal"], H, {"resizeDirection": {"_0": "right"}})
bind(K["comma"], H, {"resizeDirection": {"_0": "down"}})
bind(K["period"], H, {"resizeDirection": {"_0": "up"}})
bind(K["backslash"], H | S, {"toggleSplit": {}})  # ctrl+|, the | of LazyVim's <leader>|
bind(K["tab"], H, {"cycleWorkspace": {"_0": 1}})
bind(K["tab"], H | O, {"cycleWorkspace": {"_0": -1}})
# window to the monitor on the left / right; Ctrl+Opt+Shift+H could not be pressed on the Dygma
bind(K["lbracket"], H | S, {"moveWorkspaceToMonitor": {"_0": "left"}})
bind(K["rbracket"], H | S, {"moveWorkspaceToMonitor": {"_0": "right"}})
bind(K["space"], H | O, {"showWorkspaceOverview": {}})
bind(K["l"], H | C, {"showWorkspaceOverview": {}})
# The Dygma "Windows" superkey sends ctrl+cmd+l in one report: HyprMac's HID check calls that Hypr
# stale and passes it on with a plain control flag, so match that form too.
bind(K["l"], CTRL | C, {"showWorkspaceOverview": {}})
bind(K["slash"], H | O, {"runCommand": {"label": "Dygma cheats", "command": f"{BIN}/dygma-cheats --choose"}})
bind(K["r"], H | O, {"runCommand": {"label": "Read Claude", "command": f"{BIN}/read-claude"}})
bind(K["c"], H | O, {"runCommand": {"label": "Read clipboard", "command": f"{BIN}/read-claude --clip"}})
bind(K["quote"], H, {"toggleFloating": {}})
bind(K["f"], H | O | S, {"focusFloating": {}})
bind(K["k"], H | O, {"showKeybinds": {}})
# Greg launches apps elsewhere. HyprMac re-injects its default launchApp (Terminal on Hypr+Return,
# i.e. Ctrl+Enter, the same Dygma thumb key) whenever no saved bind has that exact action, so park it
# on a chord nobody presses.
bind(K["ret"], H | S | O | C, {"launchApp": {"bundleID": "com.apple.Terminal"}})
bind(K["m"], H | O, {"focusMenuBar": {}})
bind(K["f"], H, {"moveToNextEmptyWorkspace": {}})  # HyprMac's fullscreen
bind(K["w"], H | O | S, {"closeWindow": {}})
bind(K["s"], H, {"toggleScratchpad": {}})
bind(K["s"], H | S, {"moveToScratchpad": {}})
bind(K["t"], H | O, {"toggleTiling": {}})
bind(K["y"], H | O | S, {"saveLayout": {}})
bind(K["u"], H | O | S, {"restoreLayout": {}})
bind(K["semicolon"], H, {"retileAll": {}})

# HyprMac checks the HID state on every Hypr chord, and for left Control it often reads "up" on a
# quick press, on the MacBook keyboard too, then clears Hypr and passes the stroke on with a plain
# control flag (54 of 151 chords on 2026-10-25). A twin on control catches that form.
for b in list(binds):
    if b["modifiers"] & H:
        twin = (b["modifiers"] & ~H) | CTRL
        if not any(o["keyCode"] == b["keyCode"] and o["modifiers"] == twin for o in binds):
            bind(b["keyCode"], twin, b["action"])

chords = [(b["keyCode"], b["modifiers"]) for b in binds]
assert len(chords) == len(set(chords)), "duplicate chord"

# Chords this script wrote before and dropped (2026-10-25: frequent actions moved off 4-key
# chords). Listed so merge() removes them instead of keeping them as if Greg had added them.
RETIRED = {(K["r"], H | O | S), (K["f"], H | O), (K["k"], H | O | S), (K["j"], H | O | S),
           (K["ret"], H | O), (K["ret"], H), (K["tab"], H | S), (K["h"], H | O | S),
           (K["slash"], H)}
RETIRED |= {(k, (m & ~H) | CTRL) for k, m in RETIRED}


def merge(live):
    key = lambda b: json.dumps(b, sort_keys=True)
    mine = set(map(key, binds))
    kept = []
    for b in live.get("keybinds") or []:
        if key(b) in mine:
            continue
        if (b["keyCode"], b["modifiers"]) in RETIRED:
            continue
        if (b["keyCode"], b["modifiers"]) in chords:
            print("replaced UI chord:", key(b), file=sys.stderr)
        else:
            kept.append(b)
    live["keybinds"] = binds + kept
    old_pins = {(b, OLD_WS[ws]) for ws, ids in PINS.items() for b in ids}
    rules = [r for r in live.get("windowRules") or [] if (r["bundleID"], r["workspace"]) not in old_pins]
    have = {r["bundleID"] for r in rules}
    pins = [{"bundleID": b, "workspace": WS[ws]} for ws, ids in PINS.items() for b in ids if b not in have]
    live["windowRules"] = rules + pins
    live["excludedBundleIDs"] = sorted(set(live.get("excludedBundleIDs") or []) | set(FLOAT))
    # names shown instead of numbers (HUD, menu bar, pickers); a name set in Settings wins
    names = {str(n): name for name, n in WS.items()}
    old_names = {str(n): name for name, n in OLD_WS.items()}
    theirs = {n: name for n, name in (live.get("workspaceNames") or {}).items() if old_names.get(n) != name}
    live["workspaceNames"] = {**names, **theirs}
    # moved to monitor-config.json in HyprMac 0.19
    live.pop("statusExportEnabled", None)
    live.pop("statusHookCommand", None)
    live["hyprKey"] = "leftControl"
    return live


def merge_monitors(mon):
    # a monitor's list set in Settings wins, and the workspaces it claims leave the other monitors
    theirs = mon.get("workspaceMonitors") or {}
    taken = {n for ws in theirs.values() for n in ws}
    ours = {m: [n for n in ws if n not in taken] for m, ws in WS_MONITORS.items() if m not in theirs}
    mon["workspaceMonitors"] = {**{m: ws for m, ws in ours.items() if ws}, **theirs}
    # the fork-era topPaddingPerMonitor became outerPaddingPerMonitor upstream
    old = {m: {"top": t} for m, t in (mon.pop("topPaddingPerMonitor", None) or {}).items()}
    pad = mon.get("outerPaddingPerMonitor") or {}
    mon["outerPaddingPerMonitor"] = {m: {**OUTER_PADDING.get(m, {}), **old.get(m, {}), **pad.get(m, {})}
                                     for m in {*OUTER_PADDING, *old, *pad}}
    # sketchybar reads state.json; the hook tells its watcher something changed
    mon["statusExportEnabled"] = True
    mon.setdefault("statusHookCommand", f"{BIN}/sketchybar-watcher/sketchybar-watcher notify --event hyprmac")
    return mon


def main():
    live = merge(json.load(open(LIVE)))
    if "--dry-run" in sys.argv:
        mon = merge_monitors(json.load(open(MONITORS)) if os.path.exists(MONITORS) else {})
        json.dump({"config.json": live, "monitor-config.json": mon}, sys.stdout, indent=2)
        return
    backups = os.path.expanduser("~/.local/state/hyprmac/backups")
    os.makedirs(backups, exist_ok=True)
    shutil.copy(LIVE, f"{backups}/config-{time.strftime('%Y%m%d-%H%M%S')}.json")
    # HyprMac writes its config back on quit, so the merge goes in only after it is gone.
    # A local debug build runs as "HyprMac Debug", the release as "HyprMac".
    app = "HyprMac Debug" if not subprocess.run(["pgrep", "-x", "HyprMac Debug"], capture_output=True).returncode else "HyprMac"
    subprocess.run(["osascript", "-e", f'quit app "{app}"'], timeout=15, check=False)
    for _ in range(20):
        if subprocess.run(["pgrep", "-x", app], capture_output=True).returncode:
            break
        time.sleep(0.5)
    live = merge(json.load(open(LIVE)))
    with open(LIVE, "w") as f:
        json.dump(live, f, indent=2)
    mon = merge_monitors(json.load(open(MONITORS)) if os.path.exists(MONITORS) else {})
    with open(MONITORS, "w") as f:
        json.dump(mon, f, indent=2)
    subprocess.run(["open", "-a", app], check=True)
    print(f"merged {len(binds)} chords, {len(live['windowRules'])} pins into {LIVE}")


if __name__ == "__main__":
    main()
