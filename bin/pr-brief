#!/usr/bin/env nu

# pr-brief — print a ready-to-run agent prompt for a PR that needs work. Called by
# `work pr`'s agent intents (`work-pr _brief` in dot_config/nushell/autoload/workpr.nu),
# which caches this stdout to ~/.cache/pr-brief-<num>.md and hands the file to
# `claude` as its first message, so the agent starts already knowing the task.
#
# NOT called by bin/pr-watch-open any more — that lost its worktree/agent launch in
# 100f667 and now only opens the browser (left) or gh-dash (right).
#
# Standalone (no `work` autoload dependency) — only needs `gh`.

# The agent intents `work pr` can start. Each maps 1:1 onto a skill under
# agent-skills/, and the brief's framing mirrors what that SKILL.md expects as a
# first message. No --intent = the original fix-CI-shaped brief, unchanged.
const INTENTS = ["review" "respond" "fix-ci" "babysit" "bump"]

# Work repo is only the DEFAULT — `--repo owner/name` overrides it, because `work
# pr` also drives PRs in satellite repos. It comes from the private work.env
# (restored from 1Password by `sync`); never hardcode org/repo names here — this
# file is public.
def work-repo []: nothing -> string {
    let from_env = ($env.WORK_MAIN_REPO? | default "")
    if $from_env != "" { return $from_env }
    let f = ($nu.home-dir | path join ".local/state/dotfiles/secrets/work.env")
    if not ($f | path exists) {
        error make {msg: "WORK_MAIN_REPO not set and work.env missing — run `sync` to restore it"}
    }
    open $f | lines | where {|l| $l starts-with "WORK_MAIN_REPO="} | first | str replace "WORK_MAIN_REPO=" ""
}

# Unresolved review threads — only reachable via GraphQL (gh pr view --json has no
# reviewThreads field). Returns [] on any failure.
def review-threads [num: int, repo: string]: nothing -> list {
    let parts = ($repo | split row "/")
    let q = 'query($owner:String!,$name:String!,$num:Int!){repository(owner:$owner,name:$name){pullRequest(number:$num){reviewThreads(first:100){nodes{isResolved path line comments(first:1){nodes{author{login} body}}}}}}}'
    let r = (do {
        # -f, not -F, for the String! variables: -F type-coerces, so an all-digit
        # owner or repo name would go out as an Int and GraphQL would reject it.
        ^gh api graphql -f $"query=($q)" -f $"owner=($parts.0)" -f $"name=($parts.1)" -F $"num=($num)"
    } | complete)
    if $r.exit_code != 0 { return [] }
    ($r.stdout | from json | get -o data.repository.pullRequest.reviewThreads.nodes | default []
        | each {|t|
            {
                isResolved: ($t | get -o isResolved | default false),
                path: ($t | get -o path | default ""),
                line: ($t | get -o line | default ""),
                author: ($t | get -o comments.nodes.0.author.login | default "?"),
                body: ($t | get -o comments.nodes.0.body | default ""),
            }
        })
}

# Header + rows only. Intent briefs carry data, not instructions — the skill
# each brief dispatches already owns its flow, so nothing is repeated here.
def checks-section [failed: list] {
    print "## Failujące checki CI"
    for c in $failed {
        let name = ($c | get -o name | default ($c | get -o context | default "check"))
        let url = ($c | get -o detailsUrl | default ($c | get -o targetUrl | default ""))
        print $"- ($name) ($url)"
    }
}

def threads-section [threads: list] {
    print "## Nierozwiązane wątki review"
    for t in $threads {
        let body = ($t.body | str replace -a "\n" " " | str trim)
        let body_short = (if ($body | str length) > 240 { $"($body | str substring 0..240)…" } else { $body })
        print $"- [($t.path):($t.line)] @($t.author): ($body_short)"
    }
}

# The no-flag output, byte-for-byte what pr-brief printed before --intent existed.
# bin/pr-watch-open and the sketchybar chip depend on it, so it stays frozen.
def legacy-brief [pr: record, failed: list, threads: list] {
    print $"Pracujesz nad PR #($pr.number): ($pr.title)"
    print $pr.url
    print ""

    if ($failed | is-not-empty) {
        checks-section $failed
        print ""
        print "Zbadaj logi tych checków, znajdź przyczynę i napraw. Uruchom odpowiednie testy lokalnie żeby potwierdzić fix przed pushem."
        print ""
    }

    if ($threads | is-not-empty) {
        threads-section $threads
        print ""
        print "Zaadresuj każdy wątek w kodzie. Po wprowadzeniu zmian napisz krótką odpowiedź na każdy komentarz (po angielsku)."
        print ""
    }

    if ($failed | is-empty) and ($threads | is-empty) {
        print "Brak wykrytych failujących checków ani otwartych wątków review — sprawdź stan PRki ręcznie."
    }
}

# Shared preamble for every intent brief: who owns the PR, where it points, and a
# one-line state summary so the agent does not re-query gh just to orient itself.
def intent-header [pr: record, failed: list, threads: list] {
    print $"Pracujesz nad PR #($pr.number): ($pr.title)"
    print $pr.url

    let author = ($pr | get -o author.login | default "?")
    let head = ($pr | get -o headRefName | default "?")
    let base = ($pr | get -o baseRefName | default "?")
    print $"Autor: @($author) · ($head) → ($base)"

    mut flags = []
    if ($pr | get -o isDraft | default false) { $flags = ($flags | append "draft") }
    if (($pr | get -o mergeable | default "") == "CONFLICTING") { $flags = ($flags | append "konflikt z bazą") }
    let flag_txt = ($flags | str join " · ")
    let tail = (if ($flag_txt | is-empty) { "" } else { $" · ($flag_txt)" })
    print $"Stan: ($failed | length) czerwonych checków · ($threads | length) nierozwiązanych wątków($tail)"
}

# g-pr-review — reviewer side, PR you did NOT author. Its P2 guard settles
# authorship itself and bounces to g-pr-respond when the PR turns out to be mine,
# so the brief only has to say which side of the table we are on.
def brief-review [pr: record, failed: list, threads: list] {
    # LINE 1, always. Only a leading slash command is intercepted client-side —
    # anywhere else it reaches the model as prose and no skill is dispatched.
    print $"/g-pr-review ($pr.number)"
    print ""
    # Data only — no task paragraph. The skill already carries the flow (silent
    # analysis, Post/Skip, verdict, voice gate, red-CI rule); repeating it here
    # burned tokens on every review and told the model nothing new.
    intent-header $pr $failed $threads
    print ""

    if ($threads | is-not-empty) {
        threads-section $threads
        print ""
    }

    if ($failed | is-not-empty) {
        checks-section $failed
        print ""
    }
}

# g-pr-respond — author side, my own PR. Flow is fetch → triage → fix → commit →
# Greg pushes → post replies, and it never issues `gh pr review`.
def brief-respond [pr: record, failed: list, threads: list] {
    print $"/g-pr-respond ($pr.number)"
    print ""
    # Data only — the skill owns the flow (fetch → triage → fix → commit →
    # `pushed` gate → replies, never `gh pr review`).
    intent-header $pr $failed $threads
    print ""

    if ($threads | is-not-empty) {
        threads-section $threads
        print ""
    }

    if ($failed | is-not-empty) {
        checks-section $failed
        print ""
    }
}

# g-pr-fix-checks — rebase + force-with-lease + run_e2e toggle. It normally lists
# all my open PRs and asks which to touch, so the brief has to pin it to this one.
def brief-fix-ci [pr: record, failed: list, threads: list] {
    print $"/g-pr-fix-checks ($pr.number)"
    print ""
    intent-header $pr $failed $threads
    print ""
    # The one thing the skill cannot know: it normally lists every open PR and
    # asks which to touch — this run is pinned to a single one.
    print $"Tylko #($pr.number) — nie ruszaj pozostałych moich PRek."
    print ""

    if ($failed | is-not-empty) {
        checks-section $failed
        print ""
    }
}

# babysit-prs — one autonomous pass, no confirmations. Normally sweeps every open
# PR, so the scoping line matters more here than anywhere else.
def brief-babysit [pr: record, failed: list, threads: list] {
    print $"/babysit-prs ($pr.number)"
    print ""
    intent-header $pr $failed $threads
    print ""
    # Two things the skill cannot know: the sweep is pinned to one PR, and a
    # draft picked by hand is not the WIP the skill's draft-skip is guarding.
    print $"Jeden przebieg zawężony do #($pr.number) — nie ruszaj pozostałych PRek."
    if ($pr | get -o isDraft | default false) {
        print "To draft wybrany ręcznie — obsłuż go mimo domyślnego pomijania draftów."
    }
    print ""

    if ($failed | is-not-empty) {
        checks-section $failed
        print ""
    }

    if ($threads | is-not-empty) {
        threads-section $threads
        print ""
    }
}

# g-pr-bump — Slack nudge, no code. It resolves pending reviewers from gh itself
# and assumes the main monorepo, so the brief only has to pin the PR, name the
# repo (its cross-repo guard needs it) and repeat the confirm-before-posting rule.
def brief-bump [pr: record, repo: string, threads: list] {
    print $"/g-pr-bump ($pr.number)"
    print ""
    print $"Pracujesz nad PR #($pr.number): ($pr.title)"
    print $pr.url
    let author = ($pr | get -o author.login | default "?")
    # Repo stays: the skill's cross-repo guard needs it. Everything else
    # (pending list from gh, thread reply, confirm-before-send) is in the skill.
    print $"Repo: ($repo) · autor: @($author)"
    if ($threads | is-not-empty) {
        print $"($threads | length) nierozwiązanych wątków review na PRce."
    }
    print ""
}

# Print an agent-ready brief for a PR.
#
# Without --intent: the original fix-CI-shaped brief (failing checks + unresolved
# threads). With --intent: the same context reframed for one specific skill, with
# that skill's invocation as LINE 1 (client-side interception only fires on a
# leading slash command) and the PR context underneath.
def main [
    num: int                 # PR number
    --intent: string = ""    # review | respond | fix-ci | babysit | bump — omit for the plain brief
    --repo: string = ""      # owner/name — defaults to WORK_MAIN_REPO from work.env
] {
    if ($intent != "") and ($intent not-in $INTENTS) {
        let allowed = ($INTENTS | str join ", ")
        error make {msg: $"unknown --intent '($intent)' — expected one of: ($allowed)"}
    }

    # One resolution for every gh call below, so a satellite-repo PR is never
    # briefed against the work monorepo by accident.
    let target = (if $repo != "" { $repo } else { work-repo })

    let r = (do { ^gh pr view $num --repo $target --json "number,title,url,statusCheckRollup,headRefName,baseRefName,author,isDraft,mergeable" } | complete)
    if $r.exit_code != 0 {
        print $"Pracujesz nad PR #($num) w ($target). Nie udało się pobrać szczegółów \(gh\): ($r.stderr | str trim)"
        return
    }
    let pr = ($r.stdout | from json)

    let failed = ($pr.statusCheckRollup | where {|c|
        (($c | get -o conclusion | default "") == "FAILURE") or (($c | get -o state | default "") == "FAILURE")
    })
    let threads = (review-threads $num $target | where {|t| not $t.isResolved})

    match $intent {
        "" => { legacy-brief $pr $failed $threads }
        "review" => { brief-review $pr $failed $threads }
        "respond" => { brief-respond $pr $failed $threads }
        "fix-ci" => { brief-fix-ci $pr $failed $threads }
        "babysit" => { brief-babysit $pr $failed $threads }
        "bump" => { brief-bump $pr $target $threads }
    }
}
