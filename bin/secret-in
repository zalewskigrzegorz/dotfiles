#!/usr/bin/env bash
# secret-in <abs path> — Greg types a one-off secret (hidden), it lands in a
# 0600 file under a Claude session's scratchpad/secrets/. Nothing is echoed,
# so the agent that asked never sees the value; it feeds the file to the
# consumer with `< file` / `$(< file)`. SessionEnd hook secrets-cleanup.sh
# removes the dir. Agent side: `tuios popup --wait -- secret-in <path>`.
set -uo pipefail

path=${1:-}
name=${path##*/}
case "${path%/*}" in
  /*/scratchpad/secrets) ;;
  *) echo "użycie: secret-in <scratchpad>/secrets/<nazwa>" >&2; exit 2 ;;
esac
[[ "$name" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || { echo "zła nazwa: $name" >&2; exit 2; }

umask 077
mkdir -p "${path%/*}" || exit 3
read -rsp "Sekret dla \"$name\": " value
echo
[ -n "$value" ] || { echo "pusto, nic nie zapisałem" >&2; exit 1; }
printf '%s' "$value" > "$path" || exit 3
value=
chmod 600 "$path"
echo "zapisane: $name"
