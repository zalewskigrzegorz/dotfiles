#!/bin/bash
# prefix+a: jump to an orchestrator. An orchestrator is an agent pane that started
# or parents another live agent, or one g-orch marked with meta role=orch.
# One → straight there; several → fzf. --list prints the candidates and exits.
set -euo pipefail

rows=$(tuios list-agents --all-sessions --json | jq -r '
  .agents as $a
  | $a[]
  | . as $o
  | ([$a[] | select(.parent.window == $o.window_id or .started_by.window == $o.window_id)] | length) as $kids
  | select(.meta.role == "orch" or $kids > 0)
  | [(if .meta.role == "orch" then 0 else 1 end), .session, .window_id, .name, .state, $kids]
  | @tsv' | sort -t $'\t' -k1,1n -k6,6nr | cut -f2-)

if [ "${1:-}" = "--list" ]; then printf '%s\n' "$rows"; exit 0; fi
if [ -z "$rows" ]; then echo "Brak orkiestratora (agent z dziećmi albo role=orch)."; sleep 2; exit 0; fi

if [ "$(printf '%s\n' "$rows" | wc -l)" -gt 1 ]; then
  pick=$(printf '%s\n' "$rows" | fzf --delimiter=$'\t' --with-nth=1,3,4 --prompt='orch> ' \
    --header='sesja · agent · stan' --no-sort) || exit 0
else
  pick=$rows
fi

s=$(cut -f1 <<<"$pick"); w=$(cut -f2 <<<"$pick")
tuios switch-session "$s" >/dev/null
tuios focus-window -s "$s" "$w" >/dev/null
