#!/usr/bin/env bash
# Sync agent-skills/ -> BOTH ~/.cursor/skills and ~/.claude/skills via rsync.
# Re-runs whenever the fingerprint below changes (i.e. anything in agent-skills/)
# OR whenever this script's body changes (the scope arrays below live here, so
# editing a bucket re-triggers the run_onchange hash).
#
# fingerprint: {{ output "bash" "-c" (printf "cd %q && { find agent-skills -type f -print0 2>/dev/null; find \"${DOTFILES_SECRET_DIR:-$HOME/.local/state/dotfiles/secrets}/agent-skills\" -type f -print0 2>/dev/null; } | sort -z | xargs -0 sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1" .chezmoi.sourceDir) }}

set -e

export HOMEBREW_NO_ENV_HINTS=1

SOURCE="{{ .chezmoi.sourceDir }}/agent-skills"

if [[ ! -d "$SOURCE" ]]; then
  echo "agent-skills sync: source $SOURCE missing — skipping."
  exit 0
fi

if ! command -v rsync >/dev/null 2>&1; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi

  if command -v brew >/dev/null 2>&1; then
    echo "agent-skills sync: rsync missing — installing via brew."
    brew install rsync
  else
    echo "agent-skills sync: rsync missing and brew unavailable — skipping." >&2
    exit 0
  fi
fi

# ---------------------------------------------------------------------------
# Project-scoped skills: loaded ONLY inside a specific repo (Claude Code reads
# <repo>/.claude/skills/), NOT globally. Keeping these out of ~/.claude/skills
# shrinks the always-loaded context in every OTHER repo. Everything not listed
# here stays global (shared: superpowers, g-commit, humanizer, research, design,
# personal tools like reminders/use-spark/daily-brief, etc.).
# ---------------------------------------------------------------------------
# dygma is a *command* (dot_claude/commands), not a skill, so it is not scoped here.
# WORK_SKILLS (public + private names) come from bin/place-work-skills --list — the
# single source of truth shared with `work new`/`work pr` (work.nu), so a worktree
# created LATER gets exactly the set this apply-time sync places. Without that
# sharing, fresh worktrees start without g-pr-review & friends until the next apply.
WORK_SKILLS=()
while IFS= read -r s; do [[ -n "$s" ]] && WORK_SKILLS+=("$s"); done \
  < <("{{ .chezmoi.sourceDir }}/bin/place-work-skills" --list)
DOTFILES_SKILLS=(mac-cpu-triage)
HOMELAB_SKILLS=(cast-audio)

# RETIRED: skills deliberately removed from agent-skills/. The global targets are
# rsync'd with --delete so they self-heal, but a REPO-SCOPED copy already placed
# into some repo's .claude/skills/ is only ever pruned by the loop in place_scope,
# which iterates SCOPED_ALL. A retired name is in no bucket, so without this list
# it would linger forever on every machine that ever placed it — including the lab,
# where nobody is around to `rm` it by hand. Names stay here permanently; the loop
# is idempotent and cheap. Only ever add names Greg's OWN skills used to have —
# never a team skill name, or this would delete the work monorepo's tracked skills.
# Add a name here in the SAME commit that deletes its agent-skills/ dir, never
# ahead of it. The guard below makes a premature entry harmless, but a name listed
# early would still be silently ignored, which reads as "cleanup is broken".
RETIRED=(
  quokka wallaby banner-design slides
  design brand design-system
  slack-voice g-datagrip dotfiles-sync
  g-allow-add excalidraw-slides
)

# Guard: a name only counts as retired once its source is actually gone. Without
# this, listing a name before deleting its dir would delete the placed copies of a
# skill that is still live and still being placed — the two loops would fight and
# the repo-scoped copy would flicker in and out on every apply.
# "Source exists" means it still holds at least one FILE — `git rm` leaves the
# directory behind (git tracks files, not dirs), and an empty leftover dir would
# otherwise read as a live skill and block its own retirement.
_has_files() { [[ -n "$(find "$1" -type f -print -quit 2>/dev/null)" ]]; }
_retired_checked=()
for r in "${RETIRED[@]}"; do
  if _has_files "$SOURCE/$r" || _has_files "${DOTFILES_SECRET_DIR:-$HOME/.local/state/dotfiles/secrets}/agent-skills/$r"; then
    echo "agent-skills sync: WARNING '$r' is in RETIRED but its source still exists — ignoring." >&2
  else
    _retired_checked+=("$r")
  fi
done
RETIRED=("${_retired_checked[@]}")

SCOPED_ALL=("${WORK_SKILLS[@]}" "${DOTFILES_SKILLS[@]}" "${HOMELAB_SKILLS[@]}")
# Everything place_scope is allowed to delete from a repo: currently-bucketed
# names (so a re-bucketed skill moves cleanly) plus retired ones (so a deleted
# skill disappears everywhere).
PRUNABLE_ALL=("${SCOPED_ALL[@]}" "${RETIRED[@]}")

# Private overlay: work-specific skills that must not live in the public repo.
# Restored from 1Password by run_after_05; layered AFTER the public rsync so the
# --delete pass above doesn't wipe them permanently (they're re-added each run).
PRIVATE_SOURCE="${DOTFILES_SECRET_DIR:-$HOME/.local/state/dotfiles/secrets}/agent-skills"

# --- 1) Global targets: copy everything, then prune the project-scoped ones. ---
for target in "${HOME}/.cursor/skills" "${HOME}/.claude/skills"; do
  mkdir -p "$target"
  rsync -a --delete \
    --exclude '.DS_Store' \
    "${SOURCE}/" "${target}/"
  if [[ -d "$PRIVATE_SOURCE" ]]; then
    rsync -a --exclude '.DS_Store' "${PRIVATE_SOURCE}/" "${target}/"
  fi
  # Remove project-scoped skills from the global load path.
  for s in "${SCOPED_ALL[@]}"; do
    rm -rf "${target:?}/${s}"
  done
done

# --- 2) Place each scope's skills into its repo's project-level .claude/skills. ---
# Per-skill rsync (never a dir-level --delete) so co-located TEAM skills that
# already live in the repo (the work monorepo ships its own tracked skills) are
# left untouched. Managed skills are git-excluded via .git/info/exclude so they
# never pollute a tracked/team .gitignore or show up in the team's diff.
place_scope() {
  local repo="$1"; shift
  local -a bucket=("$@")
  # -e not -d: a linked worktree's .git is a FILE ("gitdir: ...") not a dir.
  [[ -n "$repo" && -e "$repo/.git" ]] || return 0   # repo absent (e.g. on the lab) → skip
  local sk_dir="$repo/.claude/skills"
  # Resolve the REAL git dir so the exclude lands in the right place for both a
  # normal checkout (.git/info/exclude) and a worktree (…/worktrees/<n>/info/exclude).
  local gitdir; gitdir="$(git -C "$repo" rev-parse --absolute-git-dir 2>/dev/null)" || return 0
  local exf="$gitdir/info/exclude"
  mkdir -p "$sk_dir" "$gitdir/info"

  # Place / refresh this bucket's skills. Resolve source from the public repo
  # first, then the private overlay (work-only skills with private names live there).
  for s in "${bucket[@]}"; do
    # RETIRED wins over bucket membership: a name left in a bucket by mistake must
    # never be re-placed, or the prune loop below would fight the placement loop
    # on every apply.
    local retired=0
    for r in "${RETIRED[@]}"; do [[ "$s" == "$r" ]] && retired=1; done
    [[ $retired -eq 1 ]] && continue
    local src="$SOURCE/$s"
    [[ -d "$src" ]] || src="$PRIVATE_SOURCE/$s"
    [[ -d "$src" ]] || continue
    rsync -a --delete --exclude '.DS_Store' "$src/" "$sk_dir/$s/"
    if ! grep -qxF "/.claude/skills/$s/" "$exf" 2>/dev/null; then
      echo "/.claude/skills/$s/" >>"$exf"
    fi
  done

  # Drop any MANAGED skill that got re-bucketed away from this repo, plus every
  # RETIRED skill. Only touches names in PRUNABLE_ALL (Greg's own) — never team
  # skills. Also strips the matching info/exclude line, so a retired skill leaves
  # no trace in the repo's git config.
  for s in "${PRUNABLE_ALL[@]}"; do
    local keep=0
    for b in "${bucket[@]}"; do
      if [[ "$s" == "$b" ]]; then keep=1; fi
    done
    for r in "${RETIRED[@]}"; do [[ "$s" == "$r" ]] && keep=0; done
    if [[ $keep -eq 0 && -d "$sk_dir/$s" ]]; then
      rm -rf "${sk_dir:?}/${s}"
    fi
  done

  # Sweep dead info/exclude lines: any /.claude/skills/<n>/ entry whose directory
  # no longer exists is garbage regardless of who wrote it. This is what catches
  # names that were re-bucketed long ago (their dir went, the line stayed) without
  # having to guess whether a line is ours or the team's.
  if [[ -f "$exf" ]]; then
    local tmp="$exf.chezmoi-sweep"
    : >"$tmp"
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" =~ ^/\.claude/skills/(.+)/$ ]] && [[ ! -d "$repo/.claude/skills/${BASH_REMATCH[1]}" ]]; then
        continue
      fi
      printf '%s\n' "$line" >>"$tmp"
    done <"$exf"
    if ! cmp -s "$exf" "$tmp"; then mv "$tmp" "$exf"; else rm -f "$tmp"; fi
  fi

  # Leave no empty .claude/skills/ behind in a repo that now has none of ours.
  rmdir "$sk_dir" 2>/dev/null || true
}

# Work skills go into the main monorepo checkout AND every linked worktree, so
# PR/review skills are available wherever Greg is actually working. New worktrees
# created later pick them up on the next `chezmoi apply` (or a manual bin/sync).
WORK_MONOREPO="{{ index (index . "work" | default dict) "monorepoDir" | default "" }}"
if [[ -n "$WORK_MONOREPO" && -e "$WORK_MONOREPO/.git" ]]; then
  while IFS= read -r wt; do
    [[ -n "$wt" ]] && place_scope "$wt" "${WORK_SKILLS[@]}"
  done < <(git -C "$WORK_MONOREPO" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
else
  place_scope "$WORK_MONOREPO" "${WORK_SKILLS[@]}"
fi

place_scope "${HOME}/Code/dotfiles" "${DOTFILES_SKILLS[@]}"
place_scope "${HOME}/Code/home-lab" "${HOMELAB_SKILLS[@]}"

echo "agent-skills sync: $(ls -1d "${HOME}/.claude/skills"/*/ 2>/dev/null | wc -l | tr -d ' ') global skill(s); scoped → work:${#WORK_SKILLS[@]} dotfiles:${#DOTFILES_SKILLS[@]} home-lab:${#HOMELAB_SKILLS[@]}."
