{{- $vault := "Dotfiles" -}}
{{- $hasOp := lookPath "op" -}}
theme = "mocha-neon"

[workspaces]
small_on_notch = true
show_empty = false

[cpu]
chart = "line"

[appearance]
animations = true
follow_reduce_motion = false
favorite_themes = ["mocha-neon", "grayscale"]
animation_speed = "fast"
banner_entry = "icon"

[notifications]
nc_auto_restart = true


[audio.icons]

[bar]

[widgets]

[calendar]
skip = ["Google/Firefighter On-Duty Schedule", "Google/Holidays in Poland", "Maksim009@gmail.com/Święta chrześcijańskie", "Other/Birthdays", "Subscribed Calendars/Święta w Polsce"]

[plugins.hello]
enabled = false

[caffeine]
display = true
battery_below = 20

[plugins.log-watcher]
files = ["/Users/greg/Library/Logs/Gzyms/probe-test.log", "/Users/greg/Library/Logs/Gzyms/anomalies.jsonl"]
armageddon = "FATAL"
critical = ""
error = "ERROR|Exception|rebuild_storm"
warning = "main_thread_stall"
enabled = false

[[workspaces.style]]
number = 1
color = "#00FF66"

[[workspaces.style]]
number = 2
color = "#FF5500"

[[workspaces.style]]
number = 3
color = "#FF00AA"

[[workspaces.style]]
number = 4
color = "#F0F0FF"

[[workspaces.style]]
number = 5
color = "#B300FF"

[[workspaces.style]]
number = 6
color = "#00E5FF"

[[workspaces.style]]
number = 7
color = "#FF0044"

[[workspaces.style]]
number = 8
color = "#FFCC00"

[[workspaces.style]]
number = 9
color = "#3366FF"

[[workspaces.style]]
number = 10
color = "#7F849C"

[notifications.phone]
format = "pushover"

[sounds]
message = "gzyms"
success = "gzyms"
fail = "gzyms"
waiting = "gzyms"
armageddon = "gzyms"
dismiss = "gzyms"

[keys]
leader = "ctrl+cmd+l"

[keys.verbs]
snooze = "z"

[plugins.gh-prs]
hide_idle = true
right_click = "BUTTON=right ~/Code/dotfiles/bin/pr-watch-open"
sounds = "~/Code/dotfiles/assets/sounds"

[plugins.gh-builds]
notify = "all"
hide_idle = true
sounds = "~/Code/dotfiles/assets/sounds"

[audio]
banned = ["Greg iPhone  Microphone"]

[notifications.apps."com.mitchellh.ghostty"]

[hacks]
browser_media = true

[notifications.apps."plugin:agents"]

[notifications.apps."com.tinyspeck.slackmacgap"]

[updates]

[debug]
anomalies = false

[plugins.star-watcher]
repos = ["zalewskigrzegorz/gzyms"]
enabled = false

[plugins.pollen]
homey_id = {{ if $hasOp }}{{ onepasswordRead (printf "op://%s/HOMEY_ID/password" $vault) | quote }}{{ else }}""{{ end }}
homey_token = {{ if $hasOp }}{{ onepasswordRead (printf "op://%s/HOMEY_TOKEN/password" $vault) | quote }}{{ else }}""{{ end }}
enabled = true

[plugins.pln-usd]
enabled = true

[plugins.repo-watcher]
enabled = true
