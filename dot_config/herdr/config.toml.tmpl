# herdr configuration — managed by chezmoi (source: dot_config/herdr/config.toml)

# Onboarding wizard already done.
onboarding = false

[terminal]
# Per-OS: Mac uses the homebrew nu path; Linux (lab) resolves nu on PATH at pane spawn.
default_shell = "{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/nu{{ else }}/home/linuxbrew/.linuxbrew/bin/nu{{ end }}"
shell_mode = "auto"
new_cwd = "follow"

[theme]
name = "catppuccin"

# Mocha Neon overrides on top of catppuccin (see dot_config/mocha-neon/palette.lua).
# Fixed dark — no light/dark auto-switch (matches the Mocha Neon lock).
auto_switch = false
[theme.custom]
panel_bg = "#1E1E2E"
accent   = "#B347FF"
blue     = "#8BE9FD"
green    = "#A6E3A1"
red      = "#FF6B9D"
yellow   = "#FFD700"
# Selected/active row highlight. catppuccin's default active_row_bg (#1e1e2e) is
# IDENTICAL to our panel_bg → the selected element had zero contrast (invisible).
# active_row_bg = lavender-tinted surface (≈30% #9580FF over base) — clear
# selection without the loud full-accent look. (The dim-subtext washout that
# lighter tints caused is fixed separately in [ui.sidebar.agents], not here.)
# selection_bg = neutral surface1 for range/hover selection.
active_row_bg = "#423B6D"
selection_bg  = "#45475A"

[worktrees]
directory = "~/.herdr/worktrees"

[ui]
# The whole reason for the switch: attention-queue ordering (blocked first).
agent_panel_sort = "priority"
accent = "#B347FF"
# Outer terminal window title (what AeroSpace / the Ghostty tab bar shows).
# Renders on the herdr SERVER, so {hostname} = the host the panes actually run
# on. Fixes the two-identical-Ghostty-windows problem: `hd-lab` attaches to the
# lab's herdr server in a separate window, and now that window reads "minis · …"
# while the local one reads the Mac hostname. {tab} carries the hd-title topic.
window_title = "{hostname} · {workspace} · {tab}"
# Show detected agent labels on pane borders when no manual name is set.
show_agent_labels_on_pane_borders = true

# Agent-sidebar rows shipped too dim: the 2nd line (agent name) and the task/tab
# description washed out — worse than the spaces list's git branch, which reads
# fine. NOTE: `dim = false` alone did NOT lift it — herdr keeps a dark base fg for
# these tokens regardless, so an explicit bright `fg` is what actually fixes it.
[ui.sidebar.agents]
rows = [
  ["state_icon", "workspace", { token = "tab", fg = "#D8D8EC", dim = false }],
  [{ token = "agent", fg = "#B0B0CC", dim = false }],
]

[ui.toast]
# macOS desktop notification when a background agent changes state.
delivery = "herdr"
delay_seconds = 1

[ui.sound]
enabled = true

[ui.sound.agents]
claude = "on"
droid  = "off"

[session]
# "continuum for agents" — re-attach Claude conversations after a server restart.
resume_agents_on_restore = true

[keys]
# Prefix = ctrl+space — a space combo (not bare space, which would eat every space you type).
prefix = "ctrl+space"
# Cycle the agent sidebar (priority-sorted: blocked first) — the core nav. ✅ works.
next_agent = "prefix+a"
previous_agent = "prefix+shift+a"
# Open an existing worktree via herdr's native picker (work switch also does this). ✅
open_worktree = "prefix+shift+o"
# Toggle to the last pane.
last_pane = "prefix+backtick"
# Cycle workspaces. period = next ✅; comma = prev.
previous_workspace = "prefix+comma"
next_workspace = "prefix+period"
# Native remove-worktree (d = delete; `work rm` is the scripted path with confirmation).
remove_worktree = "prefix+d"
# Native new-worktree popup DISABLED — herdr 0.7.1 targets the wrong workspace
# (always ws_idx=1) instead of the focused one, so worktrees land under the wrong
# repo. prefix+shift+g is rebound below to bin/herdr-worktree-new (→ `work new`).
new_worktree = ""
# resize lives on shift+r; reload → hd-reload CLI. (Plain prefix+r was reviewr's,
# free again since that plugin went in 2026-09.)
reload_config = ""
resize_mode = "prefix+shift+r"

# Numbered jump (focus_agent / switch_workspace by digit) is impossible here:
# ctrl+digit = AeroSpace workspaces, alt = dead (Polish option layer), cmd+digit =
# macOS/Ghostty (and cmd+shift+digit = screenshots). So navigate by cycle/picker +
# the "jump to the waiting agent" command below (prefix+0).

# Plugin keybinds (installed via run_onchange_after_34-herdr-plugins-sync).
# pluck (URL/file picker) removed — its picker pane assumes a POSIX shell and breaks
# under nu. Replaced by the `url` / `of` nu commands (autoload/herdr-pick.nu): run them
# in a shell pane to fzf-pick a link/file from the scrollback and open it.

# reviewr removed 2026-09-17 — it opened its sidebar by itself on worktree.created,
# in panes with no Claude Code, and Greg never used it. prefix+r is free again.

# herdr-nvim: full-height nvim sidebar (own nvim per tab, survives the toggle) +
# a picker over the files the agent just touched. The nvim half (annotations you
# send back to the agent) is dot_config/nvim/lua/plugins/herdr-nvim.lua.
[[keys.command]]
key = "prefix+e"
type = "plugin_action"
command = "chmarax.herdr-nvim.toggle"
description = "Toggle the nvim sidebar"

[[keys.command]]
key = "prefix+o"
type = "plugin_action"
command = "chmarax.herdr-nvim.pick-file"
description = "Open a file the agent touched (fuzzy picker) in the nvim sidebar"

# scratchpad (vjeantet/herdr-scratchpad) trialled and dropped 2026-09-17: it
# works, but nvim already covers composing anything long enough to be worth
# composing, so a second buffer with its own keybind earned nothing.
# prefix+s is free.

# radar (hhdebb/herdr-radar) trialled and dropped the same day, 2026-09-17. It
# does deliver the worktree tree and per-project grouping, but it takes over
# [theme.custom] + [ui.sidebar.*] wholesale — it refuses to run otherwise, since
# a table declared twice makes config.toml unparseable and that kills every
# plugin. Its own palette made the spaces list too dim to scan, and it ate more
# vertical space than the grouping bought back. The rows above (bright fg on the
# 2nd line) are the reason this file reads better than the plugin did.

# Jump to the agent that needs you: first blocked, else done(unseen), else working
# (bin/herdr-focus-waiting). The one-key "go to the waiting agent" Greg wanted.
[[keys.command]]
key = "prefix+0"
type = "shell"
command = "/Users/greg/Code/dotfiles/bin/herdr-focus-waiting"
description = "Focus the agent that needs attention (blocked first)"

# New worktree in the FOCUSED workspace's repo (replaces the buggy native popup
# above). Opens a tab in the current repo and runs `work new` (fzf branch picker).
[[keys.command]]
key = "prefix+shift+g"
type = "shell"
command = "/Users/greg/Code/dotfiles/bin/herdr-worktree-new"
description = "New worktree in the focused repo (work new)"

# URL / file picker — our own greg.herdr-pick plugin (dot_config/herdr/plugins-src).
# type="shell" calls `herdr plugin pane open` to spawn the picker overlay (real TTY →
# fzf works). The picker scans EVERY pane's scrollback. url → browser (ctrl-y copies),
# file → nvim in a new tab. Same job as the `url`/`of` nu commands.
[[keys.command]]
key = "prefix+u"
type = "shell"
command = "{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/herdr{{ else }}/home/linuxbrew/.linuxbrew/bin/herdr{{ end }} plugin pane open --plugin greg.herdr-pick --entrypoint url-picker --focus"
description = "Pick a URL from any pane's scrollback → browser"

[[keys.command]]
key = "prefix+f"
type = "shell"
command = "{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/herdr{{ else }}/home/linuxbrew/.linuxbrew/bin/herdr{{ end }} plugin pane open --plugin greg.herdr-pick --entrypoint file-picker --focus"
description = "Pick a file from any pane's scrollback → nvim (new tab)"

# navigator: unified fuzzy picker (workspaces / SSH hosts / zoxide / agent panes /
# roots / quick actions). One key — the Dygma-button candidate. (thanhdat77, Rust TUI.)
# Was `herdr-picker-plus` — same repo, renamed at v0.3.2; migrated 2026-09-17.
[[keys.command]]
key = "prefix+t"
type = "plugin_action"
command = "herdr-navigator.open"
description = "Navigator: workspaces / servers / agents / sessions / zoxide / roots"

# tokscale: token-usage + cost dashboard pane (wraps the tokscale TUI). prefix+t is taken
# by picker-plus; prefix+y reads as yank, so tokscale gets prefix+m (money/meter).
# (astkaasa; needs tokscale via TOKSCALE_CMD.)
[[keys.command]]
key = "prefix+m"
type = "plugin_action"
command = "tokscale.dashboard.open"
description = "Tokscale token-usage dashboard"

# vim-herdr-navigation NOT bound: ctrl+hjkl is AeroSpace window-focus, and alt is
# reserved for Polish diacritics (option+l=ł), so there's no clean no-prefix chord.
# Use herdr's native prefix+h/j/k/l for pane focus instead.
