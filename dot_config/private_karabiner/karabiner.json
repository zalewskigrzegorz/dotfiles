{
  "global": { "show_in_menu_bar": false },
  "profiles": [
    {
      "name": "Default",
      "selected": true,
      "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" },
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps: tap = ctrl+space (tuios), hold = ctrl+opt+g (Gzyms)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
                "to_if_alone": [{ "key_code": "spacebar", "modifiers": ["left_control"] }],
                "to_if_held_down": [{ "key_code": "g", "modifiers": ["left_control", "left_option"], "repeat": false }],
                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 250 }
              }
            ]
          },
          {
            "description": "Both shifts = caps lock",
            "manipulators": [
              {
                "type": "basic",
                "from": { "simultaneous": [{ "key_code": "left_shift" }, { "key_code": "right_shift" }], "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "caps_lock" }]
              }
            ]
          },
          {
            "description": "Right cmd (tap or hold) = cmd+space (Raycast)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "right_command" },
                "to_if_alone": [{ "key_code": "spacebar", "modifiers": ["left_command"] }],
                "to_if_held_down": [{ "key_code": "spacebar", "modifiers": ["left_command"], "repeat": false }]
              }
            ]
          }
        ]
      }
    }
  ]
}
