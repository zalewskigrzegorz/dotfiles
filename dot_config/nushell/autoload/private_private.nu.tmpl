# Private environment variables rendered from 1Password.
# Local variable names live in ignored chezmoi data, not in git.
#
# Fallback: when the `op` CLI isn't on PATH (e.g. on the Debian lab where
# 1Password CLI lives outside homebrew), we render empty strings instead of
# crashing chezmoi apply. The env vars are still defined so downstream nu code
# can rely on their existence, just with empty values until op is installed.
{{- $vault := "Dotfiles" -}}
{{- with (index . "onePasswordVault") -}}
{{- $vault = . -}}
{{- end -}}
{{- $hasOp := lookPath "op" -}}
{{- range (index . "privateEnvVars" | default list) }}
$env.{{ . }} = {{ if $hasOp }}{{ onepasswordRead (printf "op://%s/%s/password" $vault .) | quote }}{{ else }}""{{ end }}
{{- end }}
{{- range (index . "privateEnvExpressions" | default list) }}
$env.{{ .name }} = {{ .value }}
{{- end }}
{{- /* Grafana base URL — the `url` field of the same 1Password item that holds
       the SA token, so the grafana-query.nu wrappers get it from env and never
       shell out to `op read` (a prompt) on every call. Resolved at apply; only
       the op reference lives in the repo, never the value. */ -}}
{{- if $hasOp }}
$env.GRAFANA_URL = {{ onepasswordRead (printf "op://%s/GRAFANA_SERVICE_ACCOUNT_TOKEN/url" $vault) | quote }}
{{- end }}
{{- /* GrowthBook API host — the `url` field of the same item that holds the key.
       Note this is the API origin, NOT the web UI origin: the UI at
       growthbook.bhstage.cloud serves only the frontend and 404s on /api/v1.
       Same reasoning as GRAFANA_URL — resolved at apply, never an `op read`
       per call, and only the reference lives in the repo. */ -}}
{{- if $hasOp }}
$env.GROWTHBOOK_API_HOST_STAGE = {{ onepasswordRead (printf "op://%s/GROWTHBOOK_API_KEY_STAGE/url" $vault) | quote }}
$env.GROWTHBOOK_API_HOST_PROD = {{ onepasswordRead (printf "op://%s/GROWTHBOOK_API_KEY_PROD/url" $vault) | quote }}
{{- end }}
